{% doc %}
  @prompt
    I want to display multiple icons that i upload and each one displays based on product tags. it should be desktop and mobile friendly fully customizable sizing.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-tag-icons-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-tag-icons-container-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.icon_spacing }}px;
    align-items: center;
    justify-content: {{ block.settings.alignment }};
  }

  .ai-tag-icon-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-tag-icon-item-{{ ai_gen_id }} img {
    width: {{ block.settings.icon_size_desktop }}px;
    height: {{ block.settings.icon_size_desktop }}px;
    object-fit: contain;
  }

  @media screen and (max-width: 749px) {
    .ai-tag-icons-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-tag-icon-item-{{ ai_gen_id }} img {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
    }
  }
{% endstyle %}

<tag-based-icons-{{ ai_gen_id }} class="ai-tag-icons-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-tag-icons-container-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign icon_key = 'icon_' | append: i
        assign tag_key = 'tag_' | append: i
        assign icon = block.settings[icon_key]
        assign tag = block.settings[tag_key]
      %}

      {% if icon != blank and tag != blank %}
        {% if product.tags contains tag %}
          <div class="ai-tag-icon-item-{{ ai_gen_id }}">
            <img
              src="{{ icon | image_url: width: 200 }}"
              alt="{{ tag }}"
              loading="lazy"
              width="{{ block.settings.icon_size_desktop }}"
              height="{{ block.settings.icon_size_desktop }}"
            >
          </div>
        {% endif %}
      {% endif %}
    {% endfor %}
  </div>
</tag-based-icons-{{ ai_gen_id }}>

<script>
  (function() {
    class TagBasedIcons{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const container = this.querySelector('.ai-tag-icons-container-{{ ai_gen_id }}');
        if (container && container.children.length === 0) {
          container.style.display = 'none';
        }
      }
    }

    customElements.define('tag-based-icons-{{ ai_gen_id }}', TagBasedIcons{{ ai_gen_id }});
  })();
</script>

