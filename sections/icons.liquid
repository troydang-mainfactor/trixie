{% comment %}
  Section: Product Tag Icons
  ---------------------------------------------------------------
  Displays a row of icon badges (e.g. Vegan, Cruelty Free, Gluten
  Free, Paraben Free) for whichever ones match the current
  product's tags. Fully configurable from the theme editor:
  merchants can add/remove/rename badges and pick which product
  tag each one is tied to, without touching code.

  INSTALLATION
  1. Save this file as sections/product-tag-icons.liquid in your
     theme (Online Store > Themes > Edit code > Sections > Add a
     new section).
  2. Add the section to your product template:
       - Online Store 2.0 (JSON templates): open the product page
         in the theme editor, click "Add section" inside the
         product information block, and choose "Product Tag Icons".
       - Older/liquid templates: add
           {% section 'product-tag-icons' %}
         inside sections/main-product.liquid (or product.liquid),
         somewhere the `product` object is in scope.
  3. In the theme editor, edit the section's blocks to match the
     tags you actually use on products (tag matching is case- and
     punctuation-insensitive, so "Vegan", "vegan", and "VEGAN" are
     all treated the same).
{% endcomment %}

{%- liquid
  assign visible_count = 0
  for block in section.blocks
    assign needle = block.settings.tag | handleize
    if needle != blank
      for ptag in product.tags
        assign ptag_handle = ptag | handleize
        if ptag_handle == needle
          assign visible_count = visible_count | plus: 1
          break
        endif
      endfor
    endif
  endfor
-%}

{%- if visible_count > 0 -%}
<div class="tag-icons tag-icons--{{ section.settings.alignment }}"
     style="
       --tag-icons-color: {{ section.settings.icon_color }};
       --tag-icons-text-color: {{ section.settings.text_color }};
       --tag-icons-size: {{ section.settings.icon_size }}px;
       --tag-icons-gap: {{ section.settings.gap }}px;
     ">
  {%- if section.settings.heading != blank -%}
    <h3 class="tag-icons__heading">{{ section.settings.heading | escape }}</h3>
  {%- endif -%}

  <div class="tag-icons__grid">
    {%- for block in section.blocks -%}
      {%- assign needle = block.settings.tag | handleize -%}
      {%- assign matched = false -%}
      {%- if needle != blank -%}
        {%- for ptag in product.tags -%}
          {%- assign ptag_handle = ptag | handleize -%}
          {%- if ptag_handle == needle -%}
            {%- assign matched = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- if matched -%}
        <div class="tag-icon" {{ block.shopify_attributes }}>
          <span class="tag-icon__glyph" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'vegan' -%}
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M24 43c-9 0-16-7-16-16 0-12 8-19 16-21 8 2 16 9 16 21 0 9-7 16-16 16Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                  <path d="M24 43V17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <path d="M24 24c0-5 4-8 9-8-1 5-4 8-9 8Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                  <path d="M24 31c0-5-4-8-9-8 1 5 4 8 9 8Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                </svg>
              {%- when 'cruelty_free' -%}
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <ellipse cx="24" cy="29" rx="11" ry="9" stroke="currentColor" stroke-width="2"/>
                  <path d="M16 21c-2-6-1-12 2-13 2 5 2 10 1 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M32 21c2-6 1-12-2-13-2 5-2 10-1 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  <circle cx="20" cy="27" r="1.4" fill="currentColor"/>
                  <circle cx="28" cy="27" r="1.4" fill="currentColor"/>
                  <path d="M22 32c1 1 3 1 4 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
              {%- when 'gluten_free' -%}
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M24 8v32" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <path d="M24 12c-3 1-5 3-5 6 3-1 5-3 5-6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                  <path d="M24 12c3 1 5 3 5 6-3-1-5-3-5-6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                  <path d="M24 20c-3 1-5 3-5 6 3-1 5-3 5-6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                  <path d="M24 20c3 1 5 3 5 6-3-1-5-3-5-6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                  <path d="M24 28c-3 1-5 3-5 6 3-1 5-3 5-6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                  <path d="M24 28c3 1 5 3 5 6-3-1-5-3-5-6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                  <path d="M10 38 38 10" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                </svg>
              {%- when 'paraben_free' -%}
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M20 8h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <path d="M21 8v10l-9 18a3 3 0 0 0 2.7 4.3h18.6A3 3 0 0 0 36 36l-9-18V8" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                  <path d="M16 30h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                  <path d="M10 38 38 10" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                </svg>
              {%- when 'custom' -%}
                {%- if block.settings.custom_icon != blank -%}
                  {{ block.settings.custom_icon | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48,96', alt: block.settings.label }}
                {%- endif -%}
            {%- endcase -%}
          </span>
          <span class="tag-icon__label">{{ block.settings.label | default: block.settings.tag | escape }}</span>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% style %}
  .tag-icons {
    margin: 24px 0;
    text-align: center;
  }

  .tag-icons--left { text-align: left; }
  .tag-icons--right { text-align: right; }

  .tag-icons__heading {
    font-size: 1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0 0 16px;
    color: var(--tag-icons-text-color);
  }

  .tag-icons__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(84px, max-content));
    gap: var(--tag-icons-gap, 24px);
    justify-content: center;
  }

  .tag-icons--left .tag-icons__grid { justify-content: flex-start; }
  .tag-icons--right .tag-icons__grid { justify-content: flex-end; }

  .tag-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    max-width: 120px;
  }

  .tag-icon__glyph {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--tag-icons-size, 32px);
    height: var(--tag-icons-size, 32px);
    color: var(--tag-icons-color, #1a1a1a);
  }

  .tag-icon__glyph svg,
  .tag-icon__glyph img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .tag-icon__label {
    font-size: 0.75rem;
    line-height: 1.2;
    color: var(--tag-icons-text-color, #1a1a1a);
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .tag-icons__grid {
      grid-template-columns: repeat(auto-fit, minmax(72px, max-content));
      gap: calc(var(--tag-icons-gap, 24px) * 0.6);
    }

    .tag-icon {
      max-width: 96px;
    }

    .tag-icon__label {
      font-size: 0.6875rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Product tag icons",
  "tag": "div",
  "class": "section-product-tag-icons",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional. Leave blank to hide."
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 36
    },
    {
      "type": "range",
      "id": "gap",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Space between badges",
      "default": 24
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Label color",
      "default": "#1a1a1a"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Product tag",
          "info": "Must match a tag on the product exactly (not case sensitive). e.g. Vegan"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Display label",
          "info": "Leave blank to use the tag name as the label"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "vegan", "label": "Vegan" },
            { "value": "cruelty_free", "label": "Cruelty free" },
            { "value": "gluten_free", "label": "Gluten free" },
            { "value": "paraben_free", "label": "Paraben free" },
            { "value": "custom", "label": "Custom image" }
          ],
          "default": "vegan"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon image",
          "info": "Only used when Icon is set to 'Custom image'"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Product tag icons",
      "blocks": [
        { "type": "badge", "settings": { "tag": "Vegan", "label": "Vegan", "icon": "vegan" } },
        { "type": "badge", "settings": { "tag": "Cruelty Free", "label": "Cruelty Free", "icon": "cruelty_free" } },
        { "type": "badge", "settings": { "tag": "Gluten Free", "label": "Gluten Free", "icon": "gluten_free" } },
        { "type": "badge", "settings": { "tag": "Paraben Free", "label": "Paraben Free", "icon": "paraben_free" } }
      ]
    }
  ]
}
{% endschema %}