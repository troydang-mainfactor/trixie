{%- comment -%}
  Product Badge Rules (hidden - no visible output)

  Holds the merchant-configured tag -> badge rules used by snippets/product-badges-resolve.liquid
  and snippets/product-badges.liquid. This section renders nothing itself; it exists purely so
  its blocks are reachable from anywhere in the theme via the global `sections` object -
  `sections['product_badge_rules'].blocks` - since a badge can be needed from the deeply-nested
  product card snippet and the product page, which share no other common ancestor section. One
  instance of this section ships pre-added in sections/footer-group.json (rendered on every page
  via layout/theme.liquid) so it's always present without the merchant needing to add it manually.
  Ships with zero rules - no tag names or badge text are ever assumed.
{%- endcomment -%}

{% schema %}
{
  "name": "t:content.product_badge_rules",
  "tag": "div",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.product_badge_rules_info"
    }
  ],
  "blocks": [
    {
      "type": "badge-rule",
      "name": "t:content.product_badge_rule",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "t:settings.tag",
          "info": "t:info.product_badge_rule_tag"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:settings.label"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "t:settings.background_color"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "t:settings.text_color",
          "info": "t:info.product_badge_rule_text_color"
        }
      ]
    }
  ]
}
{% endschema %}
