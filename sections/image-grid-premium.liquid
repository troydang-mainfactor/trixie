{% liquid
  assign desktop_columns = section.settings.columns
  assign desktop_rows = section.settings.rows
  assign total_tiles = desktop_columns | times: desktop_rows
%}

<section class="premium-image-grid">
  <div
    class="premium-grid"
    style="
      --columns: {{ desktop_columns }};
      --rows: {{ desktop_rows }};
    "
  >

    {% for block in section.blocks limit: total_tiles %}

      <div
        class="premium-grid__item text-{{ block.settings.vertical }}-{{ block.settings.horizontal }}"
        {{ block.shopify_attributes }}
      >

        {% if block.settings.link != blank %}
        <a href="{{ block.settings.link }}" class="premium-grid__link">
        {% endif %}

          {% if block.settings.image %}
            {{
              block.settings.image
              | image_url: width: 1800
              | image_tag:
                loading: 'lazy',
                class: 'premium-grid__image'
            }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {% endif %}

          <div class="premium-grid__overlay">

            <div class="premium-grid__content">

              {% if block.settings.heading != blank %}
                <h2>{{ block.settings.heading }}</h2>
              {% endif %}

              {% if block.settings.text != blank %}
                <div class="rte">
                  {{ block.settings.text }}
                </div>
              {% endif %}

              {% if block.settings.button_label != blank %}
                <span class="premium-grid__button">
                  {{ block.settings.button_label }}
                </span>
              {% endif %}

            </div>

          </div>

        {% if block.settings.link != blank %}
        </a>
        {% endif %}

      </div>

    {% endfor %}

  </div>
</section>

<style>

.premium-image-grid{
    width:100%;
}

.premium-grid{
    display:grid;
    grid-template-columns:repeat(var(--columns),1fr);
    width:100%;
}

.premium-grid__item{
    position:relative;
    overflow:hidden;
    aspect-ratio:1;
}

.premium-grid__link{
    display:block;
    width:100%;
    height:100%;
    color:inherit;
    text-decoration:none;
}

.premium-grid__image{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:transform .7s cubic-bezier(.2,.8,.2,1);
}

.premium-grid__overlay{
    position:absolute;
    inset:0;
    display:flex;
    padding:32px;
    color:#fff;
}

.premium-grid__content{
    display:flex;
    flex-direction:column;
    gap:12px;
    max-width:420px;
}

.premium-grid__button{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:14px 28px;
    background:#fff;
    color:#000;
    font-weight:600;
    border-radius:999px;
    opacity:0;
    transform:translateY(10px);
    transition:.35s ease;
}

.premium-grid__item:hover .premium-grid__image{
    transform:scale(1.07);
}

.premium-grid__item:hover .premium-grid__button{
    opacity:1;
    transform:translateY(0);
}

/* Placement */

.text-top-left .premium-grid__overlay{
    align-items:flex-start;
    justify-content:flex-start;
    text-align:left;
}

.text-top-center .premium-grid__overlay{
    align-items:flex-start;
    justify-content:center;
    text-align:center;
}

.text-top-right .premium-grid__overlay{
    align-items:flex-start;
    justify-content:flex-end;
    text-align:right;
}

.text-center-left .premium-grid__overlay{
    align-items:center;
    justify-content:flex-start;
    text-align:left;
}

.text-center-center .premium-grid__overlay{
    align-items:center;
    justify-content:center;
    text-align:center;
}

.text-center-right .premium-grid__overlay{
    align-items:center;
    justify-content:flex-end;
    text-align:right;
}

.text-bottom-left .premium-grid__overlay{
    align-items:flex-end;
    justify-content:flex-start;
    text-align:left;
}

.text-bottom-center .premium-grid__overlay{
    align-items:flex-end;
    justify-content:center;
    text-align:center;
}

.text-bottom-right .premium-grid__overlay{
    align-items:flex-end;
    justify-content:flex-end;
    text-align:right;
}

/* Mobile */

@media screen and (max-width:749px){

.premium-grid{
    grid-template-columns:1fr;
}

.premium-grid__item{
    aspect-ratio:1;
}

.premium-grid__overlay{
    padding:24px;
}

.premium-grid__button{
    opacity:1;
    transform:none;
}

}

</style>

{% schema %}
{
  "name": "Premium Image Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type":"range",
      "id":"columns",
      "label":"Desktop Columns",
      "min":1,
      "max":6,
      "step":1,
      "default":3
    },
    {
      "type":"range",
      "id":"rows",
      "label":"Desktop Rows",
      "min":1,
      "max":6,
      "step":1,
      "default":2
    }
  ],
  "blocks":[
    {
      "type":"image",
      "name":"Grid Item",
      "settings":[
        {
          "type":"image_picker",
          "id":"image",
          "label":"Image"
        },
        {
          "type":"text",
          "id":"heading",
          "label":"Heading"
        },
        {
          "type":"richtext",
          "id":"text",
          "label":"Text"
        },
        {
          "type":"text",
          "id":"button_label",
          "label":"Button Label",
          "default":"Shop Now"
        },
        {
          "type":"url",
          "id":"link",
          "label":"Link"
        },
        {
          "type":"select",
          "id":"vertical",
          "label":"Vertical Position",
          "default":"bottom",
          "options":[
            {"value":"top","label":"Top"},
            {"value":"center","label":"Center"},
            {"value":"bottom","label":"Bottom"}
          ]
        },
        {
          "type":"select",
          "id":"horizontal",
          "label":"Horizontal Position",
          "default":"left",
          "options":[
            {"value":"left","label":"Left"},
            {"value":"center","label":"Center"},
            {"value":"right","label":"Right"}
          ]
        }
      ]
    }
  ],
  "max_blocks":36,
  "presets":[
    {
      "name":"Premium Image Grid"
    }
  ]
}
{% endschema %}