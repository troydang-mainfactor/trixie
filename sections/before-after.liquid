{%- doc -%}
  Before & after carousel for the product page: image only. Reads the product's "Before & after
  looks" metafield (custom.before_after: list of before_after_look metaobjects with before/after
  images) and shows each look as a drag-to-compare card in a horizontal carousel with arrows and
  dots. On touch screens the compare moves only by dragging its handle, so swiping the image
  scrolls the carousel. Renders nothing when the product has no looks with both images.
{%- enddoc -%}

{%- liquid
  assign looks = product.metafields.custom.before_after.value
  assign look_count = 0
  for look in looks
    if look.before_image.value != blank and look.after_image.value != blank
      assign look_count = look_count | plus: 1
    endif
  endfor

  case section.settings.image_ratio
    when 'square'
      assign ratio = '1'
    when 'landscape'
      assign ratio = '4 / 3'
    else
      assign ratio = '4 / 5'
  endcase
-%}

{%- if look_count > 0 -%}
  <script src="{{ 'comparison-slider.js' | asset_url }}" type="module" fetchpriority="low"></script>

  <before-after-carousel
    class="before-after section section--page-width"
    style="
      --ba-bg: {{ section.settings.background_color }};
      --ba-ratio: {{ ratio }};
      --ba-per-view: {{ section.settings.per_view_desktop }};
      --ba-pad-top: {{ section.settings.padding_top }}px;
      --ba-pad-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="before-after__inner">
      <ul class="before-after__track list-unstyled" role="list" data-ba-track>
        {%- for look in looks -%}
          {%- liquid
            assign before = look.before_image.value
            assign after = look.after_image.value
            if before == blank or after == blank
              continue
            endif
            assign model = look.model_name.value | default: product.title
          -%}
          <li class="before-after__slide" data-ba-slide>
            <comparison-slider-component class="comparison-slider comparison-slider--horizontal before-after__compare">
              <div class="comparison-slider__container">
                <div
                  class="comparison-slider__media-wrapper"
                  ref="mediaWrapper"
                  data-comparison-slider
                  data-orientation="horizontal"
                >
                  <div class="comparison-slider__layer comparison-slider__layer--before">
                    {{
                      before
                      | image_url: width: 1600
                      | image_tag:
                        loading: 'lazy',
                        class: 'before-image',
                        alt: before.alt,
                        sizes: '(min-width: 990px) 34vw, 86vw',
                        widths: '400, 600, 800, 1100, 1600',
                        ref: 'beforeImage'
                    }}
                  </div>
                  <div class="comparison-slider__layer comparison-slider__layer--after">
                    {{
                      after
                      | image_url: width: 1600
                      | image_tag:
                        loading: 'lazy',
                        class: 'after-image',
                        alt: after.alt,
                        sizes: '(min-width: 990px) 34vw, 86vw',
                        widths: '400, 600, 800, 1100, 1600',
                        ref: 'afterImage'
                    }}
                  </div>

                  <div class="cs-slider__handle" data-ba-handle>
                    <span class="cs-slider__chevron">{{- 'icon-chevron-left.svg' | inline_asset_content -}}</span>
                    <span class="cs-slider__chevron">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</span>
                  </div>

                  <input
                    type="range"
                    class="cs-slider"
                    ref="slider"
                    min="0"
                    max="100"
                    value="50"
                    aria-label="Before and after: {{ model | escape }}"
                    on:input="/sync"
                    on:pointerdown="/sync"
                  >
                </div>
              </div>
            </comparison-slider-component>
          </li>
        {%- endfor -%}
      </ul>

      {%- if look_count > 1 -%}
        <button type="button" class="before-after__arrow before-after__arrow--prev" data-ba-step="-1" aria-label="Previous" hidden>
          {{- 'icon-chevron-left.svg' | inline_asset_content -}}
        </button>
        <button type="button" class="before-after__arrow before-after__arrow--next" data-ba-step="1" aria-label="Next" hidden>
          {{- 'icon-chevron-right.svg' | inline_asset_content -}}
        </button>
        <div class="before-after__dots" data-ba-dots hidden>
          {%- for i in (1..look_count) -%}
            <button type="button" class="before-after__dot" data-ba-dot="{{ forloop.index0 }}" aria-label="Go to {{ i }} of {{ look_count }}"></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </before-after-carousel>

  <script>
    if (!customElements.get('before-after-carousel')) {
      customElements.define(
        'before-after-carousel',
        class extends HTMLElement {
          connectedCallback() {
            this.track = this.querySelector('[data-ba-track]');
            this.slides = [...this.querySelectorAll('[data-ba-slide]')];
            this.dots = [...this.querySelectorAll('[data-ba-dot]')];

            this.addEventListener('click', (event) => {
              const step = event.target.closest('[data-ba-step]');
              const dot = event.target.closest('[data-ba-dot]');
              if (step) this.goTo(this.index() + Number(step.dataset.baStep));
              if (dot) this.goTo(Number(dot.dataset.baDot));
            });
            this.track.addEventListener('scroll', () => this.update(), { passive: true });
            new ResizeObserver(() => this.update()).observe(this.track);
            this.update();

            // Touch: drag the handle to compare (the range input is switched off there by CSS so a
            // swipe on the image scrolls the carousel instead)
            this.addEventListener('pointerdown', (event) => {
              const handle = event.target.closest('[data-ba-handle]');
              if (!handle || event.pointerType === 'mouse') return;
              const compare = handle.closest('comparison-slider-component');
              const wrapper = handle.parentElement;
              event.preventDefault();
              handle.setPointerCapture(event.pointerId);
              const move = (e) => {
                const rect = wrapper.getBoundingClientRect();
                compare.setValue?.(Math.min(100, Math.max(0, ((e.clientX - rect.left) / rect.width) * 100)));
              };
              const end = () => {
                handle.removeEventListener('pointermove', move);
                handle.removeEventListener('pointerup', end);
                handle.removeEventListener('pointercancel', end);
              };
              handle.addEventListener('pointermove', move);
              handle.addEventListener('pointerup', end);
              handle.addEventListener('pointercancel', end);
            });
          }

          step() {
            const [first, second] = this.slides;
            return second ? second.offsetLeft - first.offsetLeft : this.track.clientWidth;
          }

          index() {
            return Math.round(this.track.scrollLeft / this.step());
          }

          goTo(index) {
            const last = this.slides.length - 1;
            const target = this.slides[Math.max(0, Math.min(last, index))];
            this.track.scrollTo({ left: target.offsetLeft - this.slides[0].offsetLeft, behavior: 'smooth' });
          }

          update() {
            const { track } = this;
            const scrollable = track.scrollWidth > track.clientWidth + 2;
            const atStart = track.scrollLeft < 4;
            const atEnd = track.scrollLeft + track.clientWidth > track.scrollWidth - 4;
            const prev = this.querySelector('[data-ba-step="-1"]');
            const next = this.querySelector('[data-ba-step="1"]');
            const dots = this.querySelector('[data-ba-dots]');
            if (prev) prev.hidden = !scrollable || atStart;
            if (next) next.hidden = !scrollable || atEnd;
            if (dots) dots.hidden = !scrollable;

            // Last dot when scrolled to the end, so it lights up even if the last card can't snap first
            const current = atEnd ? this.slides.length - 1 : this.index();
            this.dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === current)));
          }
        }
      );
    }
  </script>
{%- endif -%}

{% stylesheet %}
  /* Extra classes beat the theme reset that makes every .section transparent */
  .shopify-section .before-after.section.section--page-width {
    background: var(--ba-bg);
    padding-block: var(--ba-pad-top) var(--ba-pad-bottom);
  }

  .before-after__inner {
    grid-column: 2;
    position: relative;
    min-width: 0;
  }

  .before-after__track {
    --ba-gap: 12px;

    display: flex;
    gap: var(--ba-gap);
    margin: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .before-after__track::-webkit-scrollbar {
    display: none;
  }

  /* Phones: one card with the next one peeking in */
  .before-after__slide {
    flex: 0 0 86%;
    min-width: 0;
    scroll-snap-align: start;
  }

  .before-after__slide:only-child {
    flex-basis: 100%;
  }

  @media screen and (min-width: 750px) {
    .before-after__track {
      --ba-gap: 16px;
    }

    .before-after__slide {
      flex-basis: calc((100% - var(--ba-gap)) / 2);
    }
  }

  @media screen and (min-width: 990px) {
    .before-after__track {
      --ba-gap: 20px;
    }

    .before-after__slide {
      flex-basis: calc((100% - (var(--ba-per-view) - 1) * var(--ba-gap)) / var(--ba-per-view));
    }

    /* Fewer looks than fit in a row: keep them a sensible size, centered */
    .before-after__track:not(:has(> :nth-child(3))) {
      justify-content: center;
    }

    .before-after__track:not(:has(> :nth-child(3))) .before-after__slide {
      flex-basis: min(560px, calc((100% - var(--ba-gap)) / 2));
    }
  }

  .before-after__compare {
    --ratio: var(--ba-ratio);
    --color-background: #fff;
    --handle-color: #000;

    aspect-ratio: var(--ba-ratio);
  }

  /* Touch: the range input covers the whole image and would swallow swipes. Turn it off and let
     only the handle drag the compare (handled in the carousel script). */
  @media (pointer: coarse) {
    .before-after__compare .cs-slider {
      pointer-events: none;
    }

    .before-after__compare .cs-slider__handle {
      pointer-events: auto;
      touch-action: none;
      cursor: grab;
    }

    /* Bigger hit area than the visible handle */
    .before-after__compare .cs-slider__handle::before {
      content: '';
      position: absolute;
      inset: -14px;
    }
  }

  .before-after__arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: #000;
    color: #fff;
    cursor: pointer;
    transform: translateY(-50%);
    transition: opacity 0.2s ease;
  }

  .before-after__arrow[hidden] {
    display: none;
  }

  .before-after__arrow svg {
    width: 14px;
    height: 14px;
  }

  .before-after__arrow--prev {
    left: 0;
  }

  .before-after__arrow--next {
    right: 0;
  }

  /* Phones: swipe instead of arrows */
  @media screen and (max-width: 749px) {
    .before-after__arrow {
      display: none;
    }
  }

  .before-after__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 16px;
  }

  .before-after__dots[hidden] {
    display: none;
  }

  .before-after__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: currentcolor;
    opacity: 0.25;
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .before-after__dot[aria-current='true'] {
    opacity: 1;
    transform: scale(1.25);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Before & after",
  "tag": "section",
  "class": "section-before-after",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the product's \"Before & after looks\" metafield as an image carousel. Hidden on products with no looks."
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ],
      "default": "portrait"
    },
    {
      "type": "range",
      "id": "per_view_desktop",
      "label": "Images per row on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FBC7E0"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Before & after"
    }
  ]
}
{% endschema %}
