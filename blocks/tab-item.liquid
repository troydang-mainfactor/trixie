{%- doc -%}
  Premium Product Information - Tab

  One instance = one tab (desktop) / accordion row (mobile). Fully merchant-configured: title,
  optional icon/small heading, content source, and visibility rules. Renders nothing of its own
  beyond markup driven entirely by settings — no hardcoded tab names or content live here.

  Visibility + content-presence are both evaluated here again (the parent section already
  evaluated them once, before emitting any markup, so it can early-exit to nothing when zero
  blocks qualify — content_for 'blocks' can't be queried ahead of render, so the section can only
  peek at `block.settings` directly; the actual per-block render still has to go through this
  block file, which re-checks the same two pure snippets to decide its own output).
{%- enddoc -%}

{%- liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  capture is_visible
    render 'product-info-check-visibility', block: block, product: product
  endcapture
-%}
{%- capture resolved_content -%}
  {%- render 'product-info-resolve-content', block: block, product: product -%}
{%- endcapture -%}
{%- assign resolved_content_stripped = resolved_content | strip_html | strip_newlines | strip -%}

{%- if is_visible == 'true' and resolved_content_stripped != blank -%}
  <div
    class="product-info-tab"
    id="ProductInfoTab-{{ block.id }}"
    {{ block.shopify_attributes }}
  >
    <div class="product-info-tab__heading">
      <button
        type="button"
        class="product-info-tab__trigger"
        id="ProductInfoTrigger-{{ block.id }}"
        aria-expanded="false"
        aria-controls="ProductInfoPanel-{{ block.id }}"
        ref="triggers[]"
        on:click="/handleTriggerClick"
      >
        {%- if block.settings.show_icon and block.settings.icon != blank -%}
          <span class="product-info-tab__icon" aria-hidden="true">{{ block.settings.icon }}</span>
        {%- endif -%}
        <span class="product-info-tab__label">
          <span class="product-info-tab__title">{{ block.settings.tab_title | escape }}</span>
          {%- if block.settings.small_heading != blank -%}
            <span class="product-info-tab__small-heading">{{ block.settings.small_heading | escape }}</span>
          {%- endif -%}
        </span>
        <span class="product-info-tab__chevron" aria-hidden="true">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>
    </div>
    <div
      class="product-info-tab__panel"
      id="ProductInfoPanel-{{ block.id }}"
      aria-labelledby="ProductInfoTrigger-{{ block.id }}"
      ref="panels[]"
      hidden
    >
      <div class="product-info-tab__panel-inner">
        {{ resolved_content }}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:names.tab_item",
  "settings": [
    {
      "type": "text",
      "id": "tab_title",
      "label": "t:settings.tab_title"
    },
    {
      "type": "text",
      "id": "small_heading",
      "label": "t:settings.small_heading"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "t:settings.show_icon",
      "default": false
    },
    {
      "type": "text",
      "id": "icon",
      "label": "t:settings.icon",
      "info": "t:info.product_info_icon",
      "visible_if": "{{ block.settings.show_icon }}"
    },
    {
      "type": "header",
      "content": "t:content.content_source"
    },
    {
      "type": "select",
      "id": "content_source",
      "label": "t:settings.content_source",
      "options": [
        { "value": "rich_text", "label": "t:options.rich_text" },
        { "value": "metafield", "label": "t:options.metafield" },
        { "value": "product_description", "label": "t:options.product_description" },
        { "value": "page", "label": "t:options.page" },
        { "value": "metaobject", "label": "t:options.metaobject" },
        { "value": "dynamic_source", "label": "t:options.dynamic_source" },
        { "value": "custom_liquid", "label": "t:options.custom_liquid" }
      ],
      "default": "rich_text"
    },
    {
      "type": "richtext",
      "id": "rich_text_content",
      "label": "t:settings.rich_text_content",
      "visible_if": "{{ block.settings.content_source == 'rich_text' }}"
    },
    {
      "type": "text",
      "id": "metafield_reference",
      "label": "t:settings.metafield_reference",
      "info": "t:info.product_info_metafield",
      "visible_if": "{{ block.settings.content_source == 'metafield' }}"
    },
    {
      "type": "page",
      "id": "page_reference",
      "label": "t:settings.page_reference"
    },
    {
      "type": "metaobject",
      "id": "metaobject_reference",
      "label": "t:settings.metaobject_reference",
      "metaobject_type": "product_info_content",
      "info": "t:info.product_info_metaobject"
    },
    {
      "type": "text",
      "id": "dynamic_source_reference",
      "label": "t:settings.dynamic_source_reference",
      "info": "t:info.product_info_dynamic_source",
      "visible_if": "{{ block.settings.content_source == 'dynamic_source' }}"
    },
    {
      "type": "liquid",
      "id": "custom_liquid_content",
      "label": "t:settings.custom_liquid",
      "info": "t:info.custom_liquid",
      "visible_if": "{{ block.settings.content_source == 'custom_liquid' }}"
    },
    {
      "type": "header",
      "content": "t:content.visibility_rules"
    },
    {
      "type": "paragraph",
      "content": "t:content.visibility_rules_info"
    },
    {
      "type": "select",
      "id": "visibility_match",
      "label": "t:settings.visibility_match",
      "options": [
        { "value": "all", "label": "t:options.all_conditions" },
        { "value": "any", "label": "t:options.any_condition" }
      ],
      "default": "all"
    },
    {
      "type": "select",
      "id": "rule_1_type",
      "label": "t:settings.rule_1",
      "options": [
        { "value": "none", "label": "t:options.always_show" },
        { "value": "product_type", "label": "t:settings.product_type" },
        { "value": "product_vendor", "label": "t:options.product_vendor" },
        { "value": "product_template", "label": "t:options.product_template" },
        { "value": "product_tag", "label": "t:options.product_tag" },
        { "value": "collection", "label": "t:options.collection_membership" },
        { "value": "availability", "label": "t:options.availability" },
        { "value": "metafield_value", "label": "t:options.metafield_value" },
        { "value": "customer_logged_in", "label": "t:options.customer_logged_in" }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "rule_1_value",
      "label": "t:settings.rule_value",
      "visible_if": "{{ block.settings.rule_1_type != 'none' and block.settings.rule_1_type != 'customer_logged_in' }}"
    },
    {
      "type": "select",
      "id": "rule_2_type",
      "label": "t:settings.rule_2",
      "options": [
        { "value": "none", "label": "t:options.always_show" },
        { "value": "product_type", "label": "t:settings.product_type" },
        { "value": "product_vendor", "label": "t:options.product_vendor" },
        { "value": "product_template", "label": "t:options.product_template" },
        { "value": "product_tag", "label": "t:options.product_tag" },
        { "value": "collection", "label": "t:options.collection_membership" },
        { "value": "availability", "label": "t:options.availability" },
        { "value": "metafield_value", "label": "t:options.metafield_value" },
        { "value": "customer_logged_in", "label": "t:options.customer_logged_in" }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "rule_2_value",
      "label": "t:settings.rule_value",
      "visible_if": "{{ block.settings.rule_2_type != 'none' and block.settings.rule_2_type != 'customer_logged_in' }}"
    },
    {
      "type": "select",
      "id": "rule_3_type",
      "label": "t:settings.rule_3",
      "options": [
        { "value": "none", "label": "t:options.always_show" },
        { "value": "product_type", "label": "t:settings.product_type" },
        { "value": "product_vendor", "label": "t:options.product_vendor" },
        { "value": "product_template", "label": "t:options.product_template" },
        { "value": "product_tag", "label": "t:options.product_tag" },
        { "value": "collection", "label": "t:options.collection_membership" },
        { "value": "availability", "label": "t:options.availability" },
        { "value": "metafield_value", "label": "t:options.metafield_value" },
        { "value": "customer_logged_in", "label": "t:options.customer_logged_in" }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "rule_3_value",
      "label": "t:settings.rule_value",
      "visible_if": "{{ block.settings.rule_3_type != 'none' and block.settings.rule_3_type != 'customer_logged_in' }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.tab_item"
    }
  ]
}
{% endschema %}
