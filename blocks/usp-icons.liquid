{% comment %}
  Theme Block: Badge (child of "Product tag icons")
  ---------------------------------------------------------------
  Renders a single icon badge if the configured product tag is
  present on the current product. This file must live alongside
  product-tag-icons-block.liquid and be named "badge" so the
  parent block can reference it.

  INSTALLATION
  Save this file as blocks/badge.liquid in your theme
  (Online Store > Themes > Edit code > Blocks > Add a new
  block file, name it "badge").

  Theme blocks can't define locally-nested block types the way
  sections do, so each badge has to be its own block file that
  the parent ("Product tag icons") references by type name.
{% endcomment %}

{%- liquid
  assign needle = block.settings.tag | handleize
  assign matched = false
  if needle != blank
    for ptag in product.tags
      assign ptag_handle = ptag | handleize
      if ptag_handle == needle
        assign matched = true
        break
      endif
    endfor
  endif
-%}

<div class="tag-icon{% unless matched %} tag-icon--hidden{% endunless %}" {{ block.shopify_attributes }}>
  <span class="tag-icon__glyph" aria-hidden="true">
    {%- case block.settings.icon -%}
      {%- when 'vegan' -%}
        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M24 43c-9 0-16-7-16-16 0-12 8-19 16-21 8 2 16 9 16 21 0 9-7 16-16 16Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <path d="M24 43V17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M24 24c0-5 4-8 9-8-1 5-4 8-9 8Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <path d="M24 31c0-5-4-8-9-8 1 5 4 8 9 8Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
        </svg>
      {%- when 'cruelty_free' -%}
        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="24" cy="29" rx="11" ry="9" stroke="currentColor" stroke-width="2"/>
          <path d="M16 21c-2-6-1-12 2-13 2 5 2 10 1 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M32 21c2-6 1-12-2-13-2 5-2 10-1 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="20" cy="27" r="1.4" fill="currentColor"/>
          <circle cx="28" cy="27" r="1.4" fill="currentColor"/>
          <path d="M22 32c1 1 3 1 4 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      {%- when 'gluten_free' -%}
        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M24 8v32" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M24 12c-3 1-5 3-5 6 3-1 5-3 5-6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          <path d="M24 12c3 1 5 3 5 6-3-1-5-3-5-6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          <path d="M24 20c-3 1-5 3-5 6 3-1 5-3 5-6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          <path d="M24 20c3 1 5 3 5 6-3-1-5-3-5-6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          <path d="M24 28c-3 1-5 3-5 6 3-1 5-3 5-6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          <path d="M24 28c3 1 5 3 5 6-3-1-5-3-5-6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          <path d="M10 38 38 10" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
        </svg>
      {%- when 'paraben_free' -%}
        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M20 8h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M21 8v10l-9 18a3 3 0 0 0 2.7 4.3h18.6A3 3 0 0 0 36 36l-9-18V8" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <path d="M16 30h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          <path d="M10 38 38 10" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
        </svg>
      {%- when 'custom' -%}
        {%- if block.settings.custom_icon != blank -%}
          {{ block.settings.custom_icon | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48,96', alt: block.settings.label }}
        {%- endif -%}
    {%- endcase -%}
  </span>
  <span class="tag-icon__label">{{ block.settings.label | default: block.settings.tag | escape }}</span>
</div>

{% schema %}
{
  "name": "Badge",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Product tag",
      "info": "Must match a tag on the product exactly (not case sensitive). e.g. Vegan"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Display label",
      "info": "Leave blank to use the tag name as the label"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "vegan", "label": "Vegan" },
        { "value": "cruelty_free", "label": "Cruelty free" },
        { "value": "gluten_free", "label": "Gluten free" },
        { "value": "paraben_free", "label": "Paraben free" },
        { "value": "custom", "label": "Custom image" }
      ],
      "default": "vegan"
    },
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "Custom icon image",
      "info": "Only used when Icon is set to 'Custom image'"
    }
  ],
  "presets": [
    { "name": "Badge", "settings": { "tag": "Vegan", "label": "Vegan", "icon": "vegan" } }
  ]
}
{% endschema %}