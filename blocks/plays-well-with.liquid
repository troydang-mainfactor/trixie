{%- doc -%}
  "Plays Well With" list on the product page: products from the Search & Discovery
  "Complementary products" metafield, each with image, title, Judge.me stars and a full-width
  add-to-bag button that uses the theme's product form (so it opens the cart drawer).
  Shade families show swatches that switch which shade is added; products with several options
  open the quick-add popup.
{%- enddoc -%}

{%- liquid
  assign source = closest.product | default: product
  assign items = source.metafields['shopify--discovery--product_recommendation'].complementary_products.value
-%}

{%- if items != blank -%}
  <div
    class="plays-well-with"
    style="
      --pww-button-bg: {{ block.settings.button_background }};
      --pww-button-text: {{ block.settings.button_text }};
    "
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.heading != blank -%}
      <h3 class="plays-well-with__heading">{{ block.settings.heading }}</h3>
    {%- endif -%}

    <ul class="plays-well-with__list list-unstyled" role="list">
      {%- for item in items limit: block.settings.max_products -%}
        {%- comment %}<locksmith:1ad4>{% endcomment -%}
          {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: item, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% else %}{% continue %}{% endif -%}
        {%- comment %}</locksmith:1ad4>{% endcomment -%}
        {%- liquid
          assign variant = item.selected_or_first_available_variant
          assign single_variant = false
          if item.variants.size == 1
            assign single_variant = true
          endif
          assign product_form_id = 'PlaysWellWith-' | append: block.id | append: '-' | append: item.id
        -%}
        {%- liquid
          # Shade family (custom.product_group): each shade is its own single-variant product
          assign shades = item.metafields.custom.product_group.value.swatches.value
        -%}
        <li class="plays-well-with__item" data-pww-item>
          <a href="{{ item.url }}" class="plays-well-with__media" tabindex="-1" aria-hidden="true" data-pww-link>
            {%- if item.featured_image -%}
              {{
                item.featured_image
                | image_url: width: 300
                | image_tag: loading: 'lazy', sizes: '120px', widths: '120, 240, 300', alt: '', data-pww-image: ''
              }}
            {%- endif -%}
          </a>

          <div class="plays-well-with__info">
            <a href="{{ item.url }}" class="plays-well-with__title" data-pww-link data-pww-title>{{ item.title }}</a>

            <div class="plays-well-with__stars jdgm-widget jdgm-preview-badge" data-id="{{ item.id }}">
              {{- item.metafields.judgeme.badge -}}
            </div>

            {%- if shades.size > 1 and single_variant -%}
              <ul class="plays-well-with__shades list-unstyled" role="list" aria-label="Shade">
                {%- for swatch in shades -%}
                  {%- liquid
                    assign shade = swatch.product.value
                    if shade == blank or shade.variants.size > 1
                      continue
                    endif
                    assign visual_kind = 'none'
                    if swatch.image.value != blank
                      assign visual_kind = 'image'
                      assign visual_url = swatch.image.value | image_url: width: 80
                    elsif swatch.color.value != blank
                      assign visual_kind = 'color'
                      assign visual_color = swatch.color.value
                    elsif shade.featured_image != blank
                      assign visual_kind = 'image'
                      assign visual_url = shade.featured_image | image_url: width: 80
                    endif
                  -%}
                  <li>
                    <button
                      type="button"
                      class="plays-well-with__shade"
                      aria-label="{{ swatch.label.value | default: shade.title | escape }}{% unless shade.available %} - Sold out{% endunless %}"
                      aria-pressed="{% if shade.id == item.id %}true{% else %}false{% endif %}"
                      data-variant-id="{{ shade.selected_or_first_available_variant.id }}"
                      data-available="{{ shade.available }}"
                      data-title="{{ shade.title | escape }}"
                      data-url="{{ shade.url }}"
                      data-image="{{ shade.featured_image | image_url: width: 300 }}"
                      data-price="{%- render 'format-price', price: shade.price -%}"
                    >
                      {%- render 'combined-listing-swatch-visual',
                        visual_kind: visual_kind,
                        visual_url: visual_url,
                        visual_color: visual_color,
                        oos_style: 'crossed_out',
                        is_available: shade.available
                      -%}
                    </button>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- if single_variant -%}
              <product-form-component
                data-section-id="{{ section.id }}"
                data-product-id="{{ item.id }}"
                on:submit="/handleSubmit"
                class="plays-well-with__form"
              >
                <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
                {%- form 'product', item, id: product_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                  <input type="hidden" name="id" ref="variantId" value="{{ variant.id }}">
                  <input type="hidden" name="quantity" value="1">
                  {% render 'add-to-cart-button',
                    add_to_cart_text: block.settings.button_label,
                    class: 'plays-well-with__button add-to-cart-button',
                    can_add_to_cart: item.available,
                    show_price: true,
                    product: item
                  %}
                {%- endform -%}
              </product-form-component>
            {%- elsif item.available -%}
              {%- comment -%} Several options: open the theme's quick-add popup to pick them {%- endcomment -%}
              <quick-add-component
                class="plays-well-with__quick-add"
                data-product-id="{{ item.id }}"
                data-product-title="{{ item.title | escape }}"
                data-product-url="{{ item.url }}"
                data-quick-add-button="choose"
              >
                <button
                  type="button"
                  class="button plays-well-with__button"
                  on:click="quick-add-component/handleClick"
                >
                  Choose options
                  <span class="add-to-cart-button__price">{%- render 'format-price', price: item.price -%}</span>
                </button>
              </quick-add-component>
            {%- else -%}
              <span class="button plays-well-with__button" aria-disabled="true">
                Sold out
                <span class="add-to-cart-button__price">{%- render 'format-price', price: item.price -%}</span>
              </span>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

<script>
  // Shade swatches in Plays Well With: point the add-to-bag form, image, title and price at the chosen shade
  if (!window.playsWellWithReady) {
    window.playsWellWithReady = true;
    document.addEventListener('click', (event) => {
      const shade = event.target.closest('.plays-well-with__shade');
      if (!shade) return;
      const item = shade.closest('[data-pww-item]');
      const { variantId, available, title, url, image, price } = shade.dataset;

      item.querySelectorAll('.plays-well-with__shade').forEach((s) => s.setAttribute('aria-pressed', String(s === shade)));
      item.querySelector('input[name="id"]').value = variantId;
      item.querySelectorAll('[data-pww-link]').forEach((a) => (a.href = url));
      item.querySelector('[data-pww-title]').textContent = title;

      const img = item.querySelector('[data-pww-image]');
      if (img && image) {
        img.removeAttribute('srcset');
        img.src = image;
      }

      const button = item.querySelector('.plays-well-with__button');
      const priceEl = button.querySelector('.add-to-cart-button__price');
      if (priceEl) priceEl.textContent = price;
      button.disabled = available !== 'true';
    });
  }
</script>

{% stylesheet %}
  .plays-well-with {
    width: 100%;
  }

  .plays-well-with__heading {
    margin: 0 0 16px;
    font-size: .875rem;
  font-weight: 600;
  }

  .plays-well-with__list {
    display: grid;
    gap: 20px;
    margin: 0;
  }

  .plays-well-with__item {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 16px;
    align-items: center;
  }

  .plays-well-with__media {
    display: block;
    aspect-ratio: 1;
    background: #fff;
    overflow: hidden;
  }

  .plays-well-with__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .plays-well-with__info {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .plays-well-with__title {
    font-weight: 500;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .plays-well-with__shades {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 2px 0 0;
    --cl-swatch-size: 24px;
    --cl-swatch-radius: var(--variant-picker-swatch-radius, 0);
  }

  .plays-well-with__shade {
    display: block;
    padding: 2px;
    border: 1px solid transparent;
    background: none;
    cursor: pointer;
    border-radius: calc(var(--cl-swatch-radius) + 2px);
  }

  .plays-well-with__shade[aria-pressed='true'] {
    border-color: var(--color-foreground);
  }

  .plays-well-with .plays-well-with__button:disabled,
  .plays-well-with .plays-well-with__button[aria-disabled='true'] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .plays-well-with__quick-add {
    display: block;
    width: 100%;
  }

  .plays-well-with__stars:empty {
    display: none;
  }

  .plays-well-with__form,
  .plays-well-with__form form,
  .plays-well-with__form add-to-cart-component {
    display: block;
    width: 100%;
  }

  .plays-well-with .plays-well-with__button {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    width: 100%;
    min-height: 48px;
    margin-top: 6px;
    padding: 12px 14px;
    font-size: 0.8125rem;
    border: 0;
    border-radius: 0;
    background: var(--pww-button-bg);
    color: var(--pww-button-text);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  .plays-well-with .plays-well-with__button:hover {
    filter: brightness(0.95);
  }

  .plays-well-with .add-to-cart-button__price-divider {
    display: none;
  }

  .plays-well-with .add-to-cart-button__price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-inline-start: auto;
    letter-spacing: 0.04em;
  }

  .plays-well-with .add-to-cart-button__price .compare-at-price {
    font-size: 0.8em;
    font-weight: 400;
    opacity: 0.6;
  }

  /* Phones: drop the struck-through price so label and price stay on one line */
  @media screen and (max-width: 749px) {
    .plays-well-with .add-to-cart-button__price .compare-at-price {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    .plays-well-with__item {
      grid-template-columns: 112px minmax(0, 1fr);
      gap: 20px;
    }

    .plays-well-with .plays-well-with__button {
      min-height: 56px;
      padding-inline: 20px;
      font-size: 0.9375rem;
      letter-spacing: 0.1em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Plays Well With",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Plays Well With"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "paragraph",
      "content": "Products come from each product's Complementary products metafield (Search & Discovery). Hidden when empty."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to bag"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#F79CC4"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Plays Well With"
    }
  ]
}
{% endschema %}
