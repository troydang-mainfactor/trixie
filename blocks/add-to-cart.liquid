

{%- doc -%}
  This block is used to display the add to cart button.
  Intended for product-form.liquid block.

  @param {string} can_add_to_cart - Whether the product can be added to the cart
  @param {string} add_to_cart_text - The text of the add to cart button
{%- enddoc -%}

{% liquid
  assign scoped_class = block.settings.style_class | append: '--' | append: block.id
  assign class = 'add-to-cart-button ' | append: block.settings.style_class | append: ' ' | append: scoped_class
  assign id = 'BuyButtons-ProductSubmitButton-' | append: block.id
  assign product = closest.product

  # This block is shared between the PDP and featured-product sections (both
  # of which pair it with their own on-page variant-picker block, which keeps
  # the hidden variant id in sync as the shopper picks options) and cards on
  # collection/search-style grids (which have no on-card picker at all).
  # Without a picker, submitting this form always adds whichever variant
  # Shopify resolves as "first available" - silently the wrong one for a
  # product with real variant options.
  #
  # There's no reliable way to detect "am I on a no-picker card" purely from
  # Liquid context here (closest.<type> only allows one argument per
  # content_for call, and that slot is already used for `product`), so this
  # is opt-in per block instance via block.settings.open_quick_add_for_variants
  # instead - turned on for the add-to-cart block instance configured inside
  # collection/search card templates, left off (default) everywhere else so
  # the PDP and featured-product's own variant pickers are untouched.
  assign quick_add_enabled = false
  if settings.quick_add or settings.mobile_quick_add
    assign quick_add_enabled = true
  endif

  assign needs_variant_choice = false
  if block.settings.open_quick_add_for_variants and product.has_only_default_variant == false and product.available and quick_add_enabled
    assign needs_variant_choice = true
  endif
%}
{% render 'button-custom-styles', block_settings: block.settings, block_id: block.id %}
{% render 'add-to-cart-button-styles' %}
{% render 'fly-to-cart-styles' %}

<span
  {{ block.shopify_attributes }}
  style="--add-to-cart-font-case: {{ settings.button_text_case }};"
>
  {% if needs_variant_choice %}
    {% liquid
      assign uses_selling_plans = false
      if product.requires_selling_plan or product.selling_plan_groups.size > 0
        assign uses_selling_plans = true
      endif
      assign option_name = product.options_with_values.first.name
      assign choose_text = 'actions.choose_option' | t: option: option_name
    %}
    {% comment %}
      Deliberately NOT using the "quick-add"/"custom-color-quick-add" classes
      here - those apply quick-add-styles.liquid's `.quick-add { position:
      absolute; inset: 0; ... }`, built for the product-card gallery's
      hover-over-the-image overlay button. Applied to this persistent,
      in-flow card button instead, it pulled the button out of normal
      document flow entirely, misaligning it (and the whole grid row) from
      its card. This button only needs the plain button styling below,
      matching the "Add to bag" button it replaces.
    {% endcomment %}
    <quick-add-component
      data-product-title="{{ product.title }}"
      data-product-id="{{ product.id }}"
      data-quick-add-button="choose"
      data-product-options-count="{{ product.options.size }}"
      data-uses-selling-plans="{{ uses_selling_plans }}"
    >
      <button
        id="{{ id }}"
        type="button"
        name="add"
        class="button {{ class }}"
        on:click="quick-add-component/handleClick"
        data-testid="standalone-add-to-cart"
      >
        {%- unless block.settings.show_price -%}
          <span
            aria-hidden="true"
            class="svg-wrapper add-to-cart-icon"
          >
            {{- 'icon-add-to-cart.svg' | inline_asset_content -}}
          </span>
        {%- endunless -%}
        {{- choose_text -}}
      </button>
    </quick-add-component>
  {% else %}
    {% render 'add-to-cart-button',
      id: id,
      class: class,
      can_add_to_cart: can_add_to_cart,
      product: product,
      add_to_cart_text: add_to_cart_text,
      data_testid: 'standalone-add-to-cart',
      show_price: block.settings.show_price
    %}
  {% endif %}
</span>

{% schema %}
{
  "name": "t:names.add_to_cart",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "t:settings.show_price_in_button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "open_quick_add_for_variants",
      "label": "t:settings.open_quick_add_for_variants",
      "info": "t:info.open_quick_add_for_variants",
      "default": false
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "t:settings.style",
      "options": [
        {
          "value": "button",
          "label": "t:options.primary"
        },
        {
          "value": "button-secondary",
          "label": "t:options.secondary"
        },
        {
          "value": "button-custom",
          "label": "t:options.custom"
        }
      ],
      "default": "button-secondary",
      "info": "t:info.edit_button_style_in_theme_settings"
    },
    {
      "type": "header",
      "content": "t:content.button_colors",
      "visible_if": "{{ block.settings.style_class == \"button-custom\" }}"
    },
    {
      "type": "color",
      "id": "custom_button_background",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_text",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_border",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    }
  ]
}
{% endschema %}
