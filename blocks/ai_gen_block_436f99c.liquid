{% doc %}
  @prompt
    I want to display multiple icons that i upload and each one displays based on product tags. it should be desktop and mobile friendly fully customizable sizing.  
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-tag-icons-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-tag-icons-container-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.icon_spacing }}px;
    align-items: center;
    justify-content: {{ block.settings.alignment }};
  }

  .ai-tag-icon-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-tag-icon-item-{{ ai_gen_id }} img {
    width: {{ block.settings.icon_size_desktop }}px;
    height: {{ block.settings.icon_size_desktop }}px;
    object-fit: contain;
  }

  @media screen and (max-width: 749px) {
    .ai-tag-icons-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-tag-icon-item-{{ ai_gen_id }} img {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
    }
  }
{% endstyle %}

<tag-based-icons-{{ ai_gen_id }}
  class="ai-tag-icons-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-tag-icons-container-{{ ai_gen_id }}">
    {% liquid
      assign icons_to_display = ''
      assign product_tags = product.tags

      for i in (1..6)
        assign tag_key = 'icon_' | append: i | append: '_tag'
        assign image_key = 'icon_' | append: i | append: '_image'
        assign tag_value = block.settings[tag_key]
        assign image_value = block.settings[image_key]

        if tag_value != blank and image_value != blank
          for product_tag in product_tags
            assign normalized_product_tag = product_tag | downcase | strip
            assign normalized_setting_tag = tag_value | downcase | strip

            if normalized_product_tag == normalized_setting_tag
              assign icon_data = image_value | append: '||' | append: tag_value
              assign icons_to_display = icons_to_display | append: '::' | append: icon_data
              break
            endif
          endfor
        endif
      endfor
    %}

    {% if icons_to_display != blank %}
      {% assign icon_array = icons_to_display | split: '::' %}
      {% for icon_item in icon_array %}
        {% if icon_item != blank %}
          {% assign icon_parts = icon_item | split: '||' %}
          {% assign icon_image = icon_parts[0] %}
          {% assign icon_tag = icon_parts[1] %}

          <div class="ai-tag-icon-item-{{ ai_gen_id }}">
            <img
              src="{{ icon_image | image_url: width: 200 }}"
              alt="{{ icon_tag | escape }}"
              loading="lazy"
              width="200"
              height="200"
            >
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>
</tag-based-icons-{{ ai_gen_id }}>

<script>
  (function() {
    class TagBasedIcons{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('tag-based-icons-{{ ai_gen_id }}', TagBasedIcons{{ ai_gen_id }});
  })();
</script>

