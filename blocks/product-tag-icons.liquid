{% liquid
  assign product = closest.product
  assign has_visible_icons = false

  if product != blank
    for i in (1..10)
      assign tag_setting_id = 'tag_' | append: i
      assign icon_setting_id = 'icon_' | append: i
      assign label_setting_id = 'label_' | append: i

      assign tag = block.settings[tag_setting_id]
      assign icon = block.settings[icon_setting_id]
      assign label = block.settings[label_setting_id]

      if tag != blank and product.tags contains tag
        if icon != blank or label != blank
          assign has_visible_icons = true
          break
        endif
      endif
    endfor
  endif
%}

{% if has_visible_icons %}
  <div
    class="
      product-tag-icons
      product-tag-icons--{{ block.settings.layout }}
      product-tag-icons--{{ block.settings.alignment }}
    "
    style="
      --tag-icons-size-desktop: {{ block.settings.icon_size }}px;
      --tag-icons-size-mobile: {{ block.settings.icon_size_mobile }}px;
      --tag-icons-color: {{ block.settings.icon_color }};
      --tag-icons-text-color: {{ block.settings.text_color }};
      --tag-icons-gap: {{ block.settings.gap }}px;
      --tag-icons-row-gap: {{ block.settings.row_gap }}px;
    "
    {{ block.shopify_attributes }}
  >
    {% for i in (1..10) %}
      {% liquid
        assign tag_setting_id = 'tag_' | append: i
        assign icon_setting_id = 'icon_' | append: i
        assign label_setting_id = 'label_' | append: i

        assign tag = block.settings[tag_setting_id]
        assign icon = block.settings[icon_setting_id]
        assign label = block.settings[label_setting_id]

        assign tag_matches = false

        if tag != blank and product.tags contains tag
          assign tag_matches = true
        endif
      %}

      {% if tag_matches and icon != blank or tag_matches and label != blank %}
        <div class="product-tag-icons__item">
          {% if icon != blank %}
            <span class="product-tag-icons__icon" aria-hidden="true">
              {{ icon }}
            </span>
          {% endif %}

          {% if label != blank %}
            <span class="product-tag-icons__label">
              {{ label }}
            </span>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
{% endif %}

{% stylesheet %}
  .product-tag-icons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--tag-icons-row-gap) var(--tag-icons-gap);
    width: 100%;
    color: var(--tag-icons-text-color);
  }

  .product-tag-icons--horizontal .product-tag-icons__item {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
  }

  .product-tag-icons--vertical .product-tag-icons__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .product-tag-icons--left {
    justify-content: flex-start;
  }

  .product-tag-icons--center {
    justify-content: center;
  }

  .product-tag-icons--right {
    justify-content: flex-end;
  }

  .product-tag-icons__item {
    gap: 8px;
    min-width: 0;
  }

  .product-tag-icons__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: var(--tag-icons-size-desktop);
    height: var(--tag-icons-size-desktop);
    color: var(--tag-icons-color);
  }

  .product-tag-icons__icon svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
    stroke: currentColor;
  }

  .product-tag-icons__label {
    color: var(--tag-icons-text-color);
    line-height: 1.3;
  }

  @media screen and (max-width: 749px) {
    .product-tag-icons__icon {
      width: var(--tag-icons-size-mobile);
      height: var(--tag-icons-size-mobile);
    }

    .product-tag-icons__item {
      gap: 6px;
    }
  }
{% endstylesheet %}

