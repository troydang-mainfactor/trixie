{% liquid
  assign product = closest.product
%}

{% if product != blank %}
  <div
    class="product-tag-icons"
    style="
      --pt-image-size: {{ block.settings.image_size }}px;
      --pt-image-size-mobile: {{ block.settings.image_size_mobile }}px;
      --pt-gap: {{ block.settings.gap }}px;
      --pt-label-color: {{ block.settings.label_color }};
    "
    {{ block.shopify_attributes }}
  >
    {% for i in (1..10) %}
      {% liquid
        assign tag_key = 'tag_' | append: i
        assign image_key = 'image_' | append: i
        assign label_key = 'label_' | append: i

        assign tag_value = block.settings[tag_key]
        assign image_value = block.settings[image_key]
        assign label_value = block.settings[label_key]
      %}

      {% if tag_value != blank and product.tags contains tag_value %}
        <div class="product-tag-icons__item">
          {% if image_value != blank %}
            <div class="product-tag-icons__image">
              {{
                image_value
                | image_url: width: 200
                | image_tag:
                  loading: 'lazy',
                  widths: '50, 75, 100, 150, 200',
                  sizes: '(max-width: 749px) var(--pt-image-size-mobile), var(--pt-image-size)',
                  alt: label_value
              }}
            </div>
          {% endif %}

          {% if label_value != blank %}
            <div class="product-tag-icons__label">
              {{ label_value }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
{% endif %}

{% stylesheet %}
  .product-tag-icons {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: flex-start;
    gap: var(--pt-gap);
    width: 100%;
  }

  .product-tag-icons__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
  }

  .product-tag-icons__image {
    width: var(--pt-image-size);
    height: var(--pt-image-size);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .product-tag-icons__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product-tag-icons__label {
    color: var(--pt-label-color);
    line-height: 1.3;
  }

  @media screen and (max-width: 749px) {
    .product-tag-icons__image {
      width: var(--pt-image-size-mobile);
      height: var(--pt-image-size-mobile);
    }

    .product-tag-icons__item {
      gap: 6px;
    }
  }
{% endstylesheet %}

