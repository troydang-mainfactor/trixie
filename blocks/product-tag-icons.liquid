{% liquid
  assign product = closest.product
%}

{% if product != blank %}
  <div
    class="product-tag-icons"
    style="
      --pt-icons-size: {{ block.settings.icon_size }}px;
      --pt-icons-size-mobile: {{ block.settings.icon_size_mobile }}px;
      --pt-icons-color: {{ block.settings.icon_color }};
      --pt-text-color: {{ block.settings.text_color }};
      --pt-gap: {{ block.settings.gap }}px;
    "
    {{ block.shopify_attributes }}
  >
    {% for i in (1..10) %}
      {% liquid
        assign tag_key = 'tag_' | append: i
        assign icon_key = 'icon_' | append: i
        assign label_key = 'label_' | append: i

        assign tag_value = block.settings[tag_key]
        assign icon_value = block.settings[icon_key]
        assign label_value = block.settings[label_key]
      %}

      {% if tag_value != blank and product.tags contains tag_value %}
        <div class="product-tag-icons__item">
          {% if icon_value != blank %}
            <span class="product-tag-icons__icon" aria-hidden="true">
              {{ icon_value }}
            </span>
          {% endif %}

          {% if label_value != blank %}
            <span class="product-tag-icons__label">
              {{ label_value }}
            </span>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
{% endif %}

{% stylesheet %}
  .product-tag-icons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: var(--pt-gap);
    width: 100%;
  }

  .product-tag-icons__item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--pt-text-color);
  }

  .product-tag-icons__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--pt-icons-size);
    height: var(--pt-icons-size);
    flex: 0 0 var(--pt-icons-size);
    color: var(--pt-icons-color);
  }

  .product-tag-icons__icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-tag-icons__label {
    color: var(--pt-text-color);
    line-height: 1.3;
  }

  @media screen and (max-width: 749px) {
    .product-tag-icons__icon {
      width: var(--pt-icons-size-mobile);
      height: var(--pt-icons-size-mobile);
      flex-basis: var(--pt-icons-size-mobile);
    }
  }
{% endstylesheet %}

