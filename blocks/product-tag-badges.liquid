{%- doc -%}
  Manual placement option for the tag-matched product badges configured in
  Theme Settings > Product tag badges. Renders the exact same badges shown
  automatically on card/product images - add this block only if you want
  explicit control over where it sits, and turn off the matching "Show on
  card image" / "Show on product page" setting in Theme Settings so badges
  don't render twice.

  @example
  {% content_for 'block', type: 'product-tag-badges', id: 'product-tag-badges' %}
{%- enddoc -%}

{% liquid
  assign product = closest.product
%}

<div {{ block.shopify_attributes }}>
  {% render 'product-tag-badges', product: product, context: block.settings.layout %}
</div>

{% schema %}
{
  "name": "t:names.product_tag_badges",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.product_tag_badges_block_info"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:settings.layout",
      "options": [
        {
          "value": "inline",
          "label": "t:options.inline"
        },
        {
          "value": "overlay",
          "label": "t:options.overlay_on_image"
        }
      ],
      "default": "inline",
      "info": "t:info.product_tag_badges_layout"
    }
  ]
}
{% endschema %}
