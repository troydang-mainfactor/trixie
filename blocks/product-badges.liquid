{%- doc -%}
  Product Badges (product page)

  Renders the same badge_system-driven badges as the product card
  (blocks/_product-card-gallery.liquid), via the shared snippets/product-badges.liquid, so a
  product never shows a different badge here than it does on the collection grid. Scoped to
  closest.product, so it can be dropped anywhere inside the Product Information section.

  Renders using product.selected_or_first_available_variant at first paint (this theme has no
  `closest.variant` dynamic source anywhere - variant selection is 100% client-side JS after
  load, same as the existing sticky-add-to-cart bar) - badges reflect the variant selected at
  page load and don't react to a later client-side variant swap.
{%- enddoc -%}

{%- liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif
  assign evaluation_variant = product_resource.selected_or_first_available_variant
-%}

{%- unless product_resource == blank -%}
  <div {{ block.shopify_attributes }}>
    {%- render 'product-badges',
      product: product_resource,
      variant: evaluation_variant,
      context: 'content',
      max: block.settings.max_badges
    -%}
  </div>
{%- endunless -%}

{% schema %}
{
  "name": "t:content.product_badges_block",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "max_badges",
      "label": "t:settings.max_badges",
      "info": "t:info.product_badges_max",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "t:content.product_badges_block"
    }
  ]
}
{% endschema %}
