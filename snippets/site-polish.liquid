{%- comment -%}
  Site-wide polish driven by theme settings: one edge margin for every section,
  optional fade-in of sections on scroll, and Judge.me reviews styled to match the brand.
{%- endcomment -%}
{% style %}
  /* One side margin for header, sections and footer (Theme settings > Page layout) */
  body:is(.page-width-wide, .page-width-normal, .page-width-narrow, .page-width-content) {
    --page-margin: {{ settings.page_margin_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    body:is(.page-width-wide, .page-width-normal, .page-width-narrow, .page-width-content) {
      --page-margin: {{ settings.page_margin_desktop }}px;
    }
  }

  {%- if settings.section_reveal %}
    /* Sections fade in as they scroll into view. Opacity only, so fixed/sticky children keep working. */
    @media (prefers-reduced-motion: no-preference) {
      @supports (animation-timeline: view()) {
        main > .shopify-section:not(:first-child) {
          animation: section-reveal linear both;
          animation-timeline: view();
          animation-range: entry 0% entry 30%;
        }
      }
    }

    @keyframes section-reveal {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
  {%- endif %}

  /* Smoother motion: page cross-fade and drawers that glide in on the GPU */
  @media (prefers-reduced-motion: no-preference) {
    ::view-transition-old(root) {
      animation: 280ms cubic-bezier(0.4, 0, 1, 1) both page-fade-out;
    }

    ::view-transition-new(root) {
      animation: 520ms cubic-bezier(0.22, 1, 0.36, 1) 80ms both page-fade-in;
    }

    .theme-drawer__dialog--opening,
    .theme-drawer__dialog--closing {
      animation-duration: 480ms;
    }

    .theme-drawer__dialog--opening {
      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
    }

    .theme-drawer__dialog--closing {
      animation-duration: 320ms;
      animation-timing-function: cubic-bezier(0.4, 0, 1, 1);
    }

    .theme-drawer__dialog[open]::backdrop {
      animation: drawer-backdrop-in 480ms ease both;
    }
  }

  @keyframes page-fade-out {
    to {
      opacity: 0;
    }
  }

  @keyframes page-fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* Overrides the theme's right-offset slide (layout every frame) with a transform slide */
  @keyframes drawer-slide-in {
    from {
      transform: translateX(100%);
    }
  }

  @keyframes drawer-slide-out {
    to {
      transform: translateX(100%);
    }
  }

  @keyframes drawer-backdrop-in {
    from {
      opacity: 0;
    }
  }

  /* Cart drawer: square controls everywhere */
  .theme-drawer__dialog :is(.button, button, .quantity-selector, input, .cart-drawer__progress, [class*='progress']) {
    border-radius: 0 !important;
  }

  /* Cart drawer line item: image left; badge, title, shade stacked; one bottom row with
     unit price, quantity and remove; line total top-right */
  .cart-drawer__items .cart-items__table-row--full-width-variants {
    grid-template-columns: 96px auto minmax(0, 1fr) auto;
    grid-template-rows: auto auto auto;
    grid-template-areas:
      'media details details price'
      'media variants variants variants'
      'media unit_price quantity remove'
      'media error error error';
    align-content: start;
    column-gap: 16px;
    row-gap: 4px;
    padding-block: 16px;
    margin-bottom: 0;

    .cart-items__media {
      grid-area: media;
      grid-row: 1 / -1;
    }

    .cart-items__media-container,
    .cart-items__media img {
      width: 96px;
      aspect-ratio: 1;
      object-fit: cover;
      border-radius: 0;
    }

    .cart-items__title {
      display: block;
      font-family: var(--font-heading--family);
      font-size: 0.9375rem;
      font-weight: 500;
      line-height: 1.3;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--color-foreground);
      text-decoration: none;
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
      -webkit-line-clamp: unset;
    }

    .cart-items__product-info .custom-tag-badges {
      margin-bottom: 6px;
    }

    .cart-items__variants-wrapper {
      text-transform: uppercase;
      letter-spacing: 0.04em;
      font-size: 0.75rem;
    }

    .cart-items__unit-price-wrapper,
    .cart-items__quantity .quantity-selector-wrapper,
    .cart-items__remove {
      align-self: center;
      margin-top: 12px;
    }

    .cart-items__unit-price-wrapper {
      font-size: 0.875rem;

      > div {
        display: flex;
        flex-wrap: wrap;
        gap: 2px 6px;
      }
    }

    .cart-items__price {
      grid-area: price;
      justify-self: end;
      font-weight: 500;
      color: var(--color-foreground);
    }

    /* Lift the quantity selector and remove button out of their shared cell onto the grid */
    .cart-items__quantity,
    .cart-items__quantity-controls {
      display: contents;
    }

    .cart-items__quantity .quantity-selector-wrapper {
      grid-area: quantity;
      justify-self: end;
    }

    .cart-items__quantity .quantity-selector {
      display: inline-flex;
      width: auto;
      height: 36px;
      border: 1px solid rgb(var(--color-foreground-rgb) / 0.5);
      background: transparent;
    }

    .cart-items__remove {
      grid-area: remove;
      justify-self: end;
      display: grid;
      place-items: center;
      width: 36px;
      height: 36px;
      padding: 0;
      background: none;
      border: 0;
      color: var(--color-foreground);

      svg {
        width: 20px;
        height: 20px;
      }
    }

    .cart-items__error {
      grid-area: error;
    }
  }

  /* Mobile card image dots (Theme settings > Product cards) */
  .card-gallery .card-gallery__dots .slideshow-controls__dots button {
    --color: {{ settings.card_dots_color | default: '#bdbdbd' }};
    --color-hover: {{ settings.card_dots_color | default: '#bdbdbd' }};
    --color-active: {{ settings.card_dots_active_color | default: '#eb008b' }};
  }

  .card-gallery .card-gallery__dots .slideshow-controls__dots button[aria-selected='true'] {
    --color: var(--color-active);
  }

  /* Mega menu: roomier links and panel padding, Fenty-style */
  header .mega-menu__link {
    font-size: 0.9375rem;
    padding-block: 7px;
  }

  header .mega-menu__link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  header .mega-menu {
    padding-block: 32px 40px;
  }

  /* Mobile menu drawer: calm 18px rows with chevrons (Fenty-style), sub-panels slide in */
  .menu-drawer .menu-drawer__menu-item--mainlist {
    font-size: 1.125rem;
    font-weight: 500;
    padding-block: 14px;
    min-height: 0;
  }

  .menu-drawer .menu-drawer__menu-item--child {
    font-size: 1rem;
    padding-block: 12px;
  }

  .menu-drawer .menu-drawer__back-button {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* Tag badges (NEW, PRE-ORDER): always one line; smaller on mobile cards */
  .custom-tag-badge {
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .custom-tag-badges--overlay .custom-tag-badge {
      font-size: 10px;
      padding: 3px 6px;
      letter-spacing: 0.04em;
    }
  }

  /* Footer: uppercase menu headings, plus-icon accordions on mobile, roomy links */
  .footer-content .menu__heading {
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* Brand wordmark spans the whole footer (a trailing script defeats the theme's last-child rule) */
  .footer-content > jumbo-text {
    grid-column: 1 / -1;
    margin-top: 24px;
  }

  .footer-content .menu__item a {
    text-decoration: none;
  }

  .footer-content .menu__item a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .footer-content .menu--accordion .menu__heading {
      padding-block: 16px;
    }

    /* Stack the accordion rows flush instead of the footer's column gap */
    .footer-content > .menu--accordion + .menu--accordion {
      margin-top: calc(-1 * var(--footer-gap));
    }
  }

  /* Judge.me reviews: brand fonts, square shapes, pink accents */
  body .jdgm-rev-widg {
    --jdgm-accent: {{ settings.color_palette.color3 | default: '#eb008b' }};
    font-family: var(--font-body--family);
    color: var(--color-foreground);
    padding-block: 48px;
  }

  body .jdgm-rev-widg__title {
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 500;
    text-align: center;
    margin-bottom: 16px;
  }

  body .jdgm-rev-widg .jdgm-star {
    color: var(--color-foreground) !important;
  }

  body .jdgm-histogram__bar {
    background: rgb(255 255 255 / 0.6);
    border-radius: 0;
  }

  body .jdgm-histogram__bar-content {
    background: var(--jdgm-accent) !important;
    border-radius: 0;
  }

  body .jdgm-write-rev-link,
  body .jdgm-rev-widg .jdgm-btn,
  body .jdgm-ask-question-btn {
    border-radius: 0 !important;
    border: 0 !important;
    background: #f79cc4 !important;
    color: var(--color-foreground) !important;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    padding: 14px 28px !important;
  }

  body .jdgm-sort-dropdown,
  body .jdgm-paginate__page,
  body .jdgm-gallery__thumbnail-wrapper,
  body .jdgm-rev__pic-img {
    border-radius: 0 !important;
  }

  body .jdgm-paginate__page {
    color: var(--color-foreground) !important;
  }

  body .jdgm-paginate__page.jdgm-curt {
    background: var(--color-foreground);
    color: #fff;
  }

  body .jdgm-rev {
    background: rgb(255 255 255 / 0.55);
    padding: 24px !important;
    margin-bottom: 12px;
    border: 0 !important;
  }

  body .jdgm-rev__title {
    font-weight: 600;
    font-size: 1rem;
  }

  body .jdgm-rev__author,
  body .jdgm-rev__timestamp {
    font-size: 0.8125rem;
  }

  body .jdgm-rev__icon {
    background: var(--jdgm-accent);
    color: #fff;
    border-radius: 0;
  }
{% endstyle %}
