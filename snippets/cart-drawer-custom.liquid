{%- doc -%}
  Custom cart drawer - schema-driven alternative to Horizon's default cart drawer.

  Rendered from two places, exactly like the default drawer it replaces:
  layout/theme.liquid (initial page load) and sections/cart-drawer-section.liquid
  (Section Rendering API target after cart changes). All configuration lives in
  global theme settings (Theme Editor > Theme settings), not section settings -
  sections/cart-drawer-section.liquid is never referenced from any template or
  section group, so it has no editor-reachable settings surface of its own.
  Global `settings.*` is available unconditionally everywhere, including from
  layout.liquid (which has no `section` variable at all), so this sidesteps
  that entirely.

  PHASE 3: real line items, empty-cart state, and real subtotal/discount/
  checkout totals. The cross-sell carousel is still a later phase.

  Line items reuse the theme's own quantity-selector snippet and the
  CartItemsComponent custom element (via cart-items-component.liquid)
  unchanged, so quantity changes and removal route through the exact same
  /cart/change.js + CartLinesUpdateEvent mechanics the default drawer already
  relies on - only the visual markup around them is custom.

  @param {boolean} [render_wrapper] - When true, wraps in the SRA section wrapper.
{%- enddoc -%}

{% liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    src="{{ 'component-cart-items.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
  <script
    src="{{ 'component-cart-quantity-selector.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
  {% render 'quantity-selector-styles' %}

  {% capture cart_badge_html %}
    <span
      class="theme-drawer__badge{% if cart.item_count == 0 %} visually-hidden{% endif %}"
      aria-hidden="true"
      {% if cart.item_count <= 99 %}
        data-maintain-ratio
      {% endif %}
    >
      {{- cart.item_count -}}
    </span>
    {% if cart.item_count > 0 %}
      <span class="visually-hidden">{{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}</span>
    {% endif %}
  {% endcapture %}
  {% assign cart_drawer_title = 'content.cart_title' | t %}

  {% liquid
    assign has_discount = false
    assign total_savings = 0
    if cart.cart_level_discount_applications.size > 0
      assign has_discount = true
      assign total_savings = cart.cart_level_discount_applications | map: 'total_allocated_amount' | sum
    endif

    assign savings_percent = 0
    if has_discount and cart.items_subtotal_price > 0
      assign savings_percent = total_savings | times: 100.0 | divided_by: cart.items_subtotal_price | round
    endif
  %}

  <theme-drawer
    id="cart-drawer"
    data-skip-node-update
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog custom-cart-drawer__dialog color-custom-drawer"
      aria-labelledby="cart-drawer-heading"
    >
      <cart-drawer-component
        {% if settings.auto_open_cart_drawer and template.name != 'cart' %}
          auto-open
        {% endif %}
      >
        <div
          class="custom-cart-drawer{% if cart.empty? %} cart-drawer--empty{% endif %}"
          style="
            --custom-cart-drawer-header-bg: {{ settings.custom_drawer_header_background_color }};
            --custom-cart-drawer-header-text: {{ settings.custom_drawer_header_text_color }};
            --custom-cart-drawer-footer-bg: {{ settings.custom_drawer_footer_background_color }};
            --custom-cart-drawer-footer-text: {{ settings.custom_drawer_footer_text_color }};
          "
        >
          <div class="custom-cart-drawer__header">
            {% render 'theme-drawer-header',
              title: cart_drawer_title,
              drawer_id: 'cart-drawer',
              heading_id: 'cart-drawer-heading',
              title_append: cart_badge_html
            %}

            {% if settings.show_milestone_bar %}
              {% render 'cart-drawer-custom-milestones' %}
            {% endif %}
          </div>

          {% if cart.empty? %}
            <div class="custom-cart-drawer__empty">
              <h2
                class="theme-drawer__title h4"
                id="cart-drawer-heading-empty"
              >
                {{ 'content.your_cart_is_empty' | t }}
              </h2>
              <a
                class="button custom-cart-drawer__empty-button"
                href="{{ settings.empty_cart_button_link | default: routes.all_products_collection_url }}"
              >
                <span class="button-text">{{ 'actions.continue_shopping' | t }}</span>
              </a>
            </div>
          {% else %}
            <form
              action="{{ routes.cart_url }}"
              class="custom-cart-drawer__body"
              id="cart-form"
              method="post"
            >
              <scroll-hint class="custom-cart-drawer__middle">
                {% capture line_items %}
                  {% for item in cart.items %}
                    {% render 'cart-drawer-custom-line-item', item: item %}
                  {% endfor %}
                {% endcapture %}
                {% render 'cart-items-component',
                  children: line_items,
                  is_drawer: true,
                  section_id: 'cart-drawer-section'
                %}
              </scroll-hint>

              <div class="custom-cart-drawer__footer">
                <div class="custom-cart-drawer__totals">
                  <div class="custom-cart-drawer__row">
                    <span>{{ 'content.cart_subtotal' | t }}</span>
                    <span data-testid="cart-subtotal-value">{{ cart.items_subtotal_price | money }}</span>
                  </div>
                  {% if has_discount %}
                    <div class="custom-cart-drawer__row custom-cart-drawer__row--discount">
                      <span>
                        {{ 'content.discounts' | t }}
                        {% if settings.show_discount_savings_badge %}
                          <span class="custom-cart-drawer__savings-badge">
                            {{ 'custom_cart_drawer.content.savings_badge' | t: percentage: savings_percent }}
                          </span>
                        {% endif %}
                      </span>
                      <span>-{{ total_savings | money }}</span>
                    </div>
                  {% endif %}
                </div>

                {% render 'tax-info', has_discounts_enabled: settings.show_add_discount_code %}

                <button
                  type="submit"
                  name="checkout"
                  class="custom-cart-drawer__checkout button"
                  {% unless cart.item_count > 0 %}
                    disabled
                  {% endunless %}
                >
                  {% if settings.show_checkout_lock_icon %}
                    <span
                      class="svg-wrapper"
                      aria-hidden="true"
                    >
                      {{- 'icon-lock.svg' | inline_asset_content -}}
                    </span>
                  {% endif %}
                  <span>{{ 'content.checkout' | t }} · {{ cart.total_price | money }}</span>
                </button>
              </div>
            </form>
          {% endif %}
        </div>
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  {% if render_wrapper %}
    </div>
  {% endif %}
{%- endif -%}

{% stylesheet %}
  .custom-cart-drawer__dialog {
    padding: 0;
    max-width: 30rem;
    width: 100%;
    height: 100%;
    height: 100dvh;
  }

  .custom-cart-drawer {
    display: flex;
    flex-direction: column;
    height: 100%;
    height: 100dvh;
  }

  .custom-cart-drawer__header {
    flex-shrink: 0;
    background: var(--custom-cart-drawer-header-bg);
    color: var(--custom-cart-drawer-header-text);
  }

  .custom-cart-drawer__header .theme-drawer__header {
    color: inherit;
  }

  .custom-cart-drawer__header .theme-drawer__close-button {
    color: inherit;
  }

  .custom-cart-drawer__empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--gap-md);
    padding: var(--padding-lg);
    text-align: center;
  }

  .custom-cart-drawer__body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .custom-cart-drawer__middle {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    touch-action: pan-y;
    padding: var(--padding-lg);
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
  }

  .custom-cart-drawer__footer {
    flex-shrink: 0;
    background: var(--custom-cart-drawer-footer-bg);
    color: var(--custom-cart-drawer-footer-text);
    padding: var(--padding-lg);
    padding-bottom: max(var(--padding-lg), env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .custom-cart-drawer__totals {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  .custom-cart-drawer__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--gap-xs);
  }

  .custom-cart-drawer__savings-badge {
    display: inline-flex;
    align-items: center;
    padding-inline: var(--padding-xs);
    border-radius: var(--style-border-radius-buttons-secondary, 4px);
    background: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-10));
    font-size: var(--font-size--xs);
  }

  .custom-cart-drawer__checkout {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap-2xs);
    min-height: 44px;
  }
{% endstylesheet %}
