{% doc %}
  Custom cart drawer - schema-driven alternative to Horizon's default cart drawer.

  This is a fork of snippets/cart-drawer.liquid (kept as close to that original
  as possible on purpose, after an earlier from-scratch rebuild of the line
  items/footer had multiple bugs). It reuses cart-products.liquid,
  cart-summary.liquid, and cart-items-component.liquid completely unmodified,
  exactly like the default drawer does - line items, quantity steppers, remove
  buttons, subtotal, discounts, tax info, and the checkout form/button are all
  the same already-proven code, not reimplemented. The only additions are the
  milestone progress bar and the header/footer zone background colors, both
  scoped to classes unique to this file so they can never affect the default
  drawer's own styling.

  Rendered from two places, exactly like the default drawer it replaces:
  layout/theme.liquid (initial page load) and sections/cart-drawer-section.liquid
  (Section Rendering API target after cart changes). Configuration lives in
  global theme settings (Theme Editor > Theme settings) rather than section
  settings, since sections/cart-drawer-section.liquid is never referenced from
  any template or section group and so has no editor-reachable settings
  surface of its own - global `settings.*` is available unconditionally
  everywhere, including from layout.liquid (which has no `section` variable
  at all), sidestepping that entirely.

  cart-summary.liquid is forked as cart-summary-custom.liquid (price on the
  checkout button, subtotal/discount lines always shown above it, and the
  savings-badge/lock-icon toggles wired up) since those changes touch the
  totals/checkout markup directly - everything else (line items, quantity
  steppers, remove buttons) still comes from the untouched originals.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true

  case settings.custom_drawer_corner_style
    when 'square'
      assign custom_drawer_radius_sm = '0px'
      assign custom_drawer_radius_md = '0px'
      assign custom_drawer_radius_pill = '0px'
    when 'pill'
      assign custom_drawer_radius_sm = '10px'
      assign custom_drawer_radius_md = '18px'
      assign custom_drawer_radius_pill = '999px'
    else
      assign custom_drawer_radius_sm = '6px'
      assign custom_drawer_radius_md = '10px'
      assign custom_drawer_radius_pill = '999px'
  endcase
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  {% capture empty_cart_drawer_content %}
    <div
      class="cart-drawer__content"
      aria-label="{{ 'accessibility.cart' | t }}"
    >
      <h2
        class="theme-drawer__title h4"
        id="cart-drawer-heading"
      >
        {{ 'content.your_cart_is_empty' | t }}
      </h2>

      <div class="cart-drawer__items">
        {% render 'cart-products', force_empty: true, context: 'drawer' %}
      </div>
    </div>
    {% endcapture %}

  <theme-drawer
    id="cart-drawer"
    data-skip-node-update
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="true"
    >
      <cart-drawer-component
        {% if settings.auto_open_cart_drawer and template.name != 'cart' %}
          auto-open
        {% endif %}
      >
        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>

        <div
          class="cart-drawer__inner{% if cart.empty? %} cart-drawer--empty{% endif %}"
          data-hydration-key="cart-drawer-inner"
          style="
            --custom-drawer-radius-sm: {{ custom_drawer_radius_sm }};
            --custom-drawer-radius-md: {{ custom_drawer_radius_md }};
            --custom-drawer-radius-pill: {{ custom_drawer_radius_pill }};
            --custom-drawer-thumbnail-size: {{ settings.custom_drawer_thumbnail_size | default: 96 }}px;
          "
        >
          {%- if cart.empty? -%}
            <div class="theme-drawer__header">
              <button
                on:click="#cart-drawer/close"
                class="theme-drawer__close-button cart-drawer__close-button--empty"
                type="button"
                aria-label="{{ 'actions.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          {%- else -%}
            <div
              class="custom-cart-drawer-zones__header-zone"
              style="
                --custom-drawer-header-bg: {{ settings.custom_drawer_header_background_color }};
                --custom-drawer-header-text: {{ settings.custom_drawer_header_text_color }};
              "
            >
              {% capture cart_badge_html %}
                <span
                  class="theme-drawer__badge{% if cart.item_count == 0 %} visually-hidden{% endif %}"
                  aria-hidden="true"
                  {% if cart.item_count <= 99 %}
                    data-maintain-ratio
                  {% endif %}
                >
                  {{- cart.item_count -}}
                </span>
                {% if cart.item_count > 0 %}
                  <span class="visually-hidden">
                    {{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}
                  </span>
                {% endif %}
              {% endcapture %}
              {% assign cart_drawer_title = 'content.cart_title' | t %}
              {% render 'theme-drawer-header',
                title: cart_drawer_title,
                drawer_id: 'cart-drawer',
                heading_id: 'cart-drawer-heading',
                title_append: cart_badge_html
              %}

              {% if settings.show_free_shipping_bar %}
                {% render 'cart-drawer-custom-milestones' %}
              {% endif %}
            </div>
          {%- endif -%}

          {% capture cart_items_children %}
            {%- if cart.empty? -%}
              {{ empty_cart_drawer_content }}
            {%- else -%}
              <scroll-hint
                class="cart-drawer__content"
                aria-label="{{ 'accessibility.cart' | t }}"
                style="--header-height: 60px;"
              >
                <scroll-hint class="cart-drawer__items">
                  {% render 'cart-products', context: 'drawer' %}
                </scroll-hint>

                <div
                  class="cart-drawer__summary custom-cart-drawer-zones__footer-zone"
                  style="
                    --custom-drawer-footer-bg: {{ settings.custom_drawer_footer_background_color }};
                    --custom-drawer-footer-text: {{ settings.custom_drawer_footer_text_color }};
                  "
                >
                  {% render 'cart-summary-custom', section_id: 'cart-drawer-section' %}
                </div>
              </scroll-hint>
            {%- endif -%}
          {% endcapture %}
          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}
        </div>
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  {% if render_wrapper %}
    </div>
  {% endif %}
{%- endif -%}

{% stylesheet %}
  cart-drawer-component {
    --cart-drawer-padding: var(--theme-drawer-padding);
    --font-paragraph--line-height: 1;
    display: contents;
  }

  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__inner > .cart-items-component {
    flex: 1;
    min-height: 0;
    height: auto;
  }

  .cart-drawer__content {
    height: calc(100% - var(--header-height));
    display: flex;
    flex-direction: column;
    padding: 0;
    background-color: var(--color-background);
    flex-grow: 1;
    overflow-y: auto;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    padding-inline: var(--cart-drawer-padding);
    overflow-y: auto;
  }

  .cart-drawer__items .cart-items__table-row {
    padding-bottom: var(--gap-xl);
    border-bottom: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    margin-bottom: var(--gap-xl);
  }

  .cart-drawer__items .cart-items__table-row:has(+ .cart-items__nested-line) {
    border-bottom: none;
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items__table-row:last-child {
    border-bottom: none;
    padding-block-end: 0;
    margin-block-end: 0;
  }

  .cart-drawer__close-button--empty {
    margin-inline-start: auto;
  }

  .cart-drawer__summary {
    --cart-drawer-summary-padding: var(--padding-lg);

    position: sticky;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xl);
    padding: var(--cart-drawer-summary-padding);
    margin-top: auto;
    background-color: var(--color-background);
    /* stylelint-disable-next-line color-named */
    mask-image: linear-gradient(to bottom, transparent, black var(--cart-drawer-summary-padding));

    @media screen and (min-width: 750px) {
      --cart-drawer-summary-padding: var(--padding-2xl);
    }
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__summary {
    position: static;
    mask-image: none;
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__items {
    overflow: unset;
  }

  .cart-actions summary {
    padding-inline: 0;
    padding-block: var(--padding-sm);
    line-height: 1.2;
    min-height: var(--minimum-touch-target);
  }

  .cart-drawer__summary .cart__summary-totals:not(:has(.cart__subtotal-container:empty)) {
    border-block-start: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--padding-2xl);
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-drawer--empty .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
    min-height: auto;
  }

  .cart-drawer--empty .cart-drawer__items {
    padding-inline: 0;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__items {
    padding-inline: 0;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    html:active-view-transition-type(empty-cart-drawer) {
      .theme-drawer__close-button {
        view-transition-name: cart-drawer-close-button;
      }
    }
  }

  :active-view-transition {
    .cart-drawer__header,
    .cart-drawer__content {
      background: transparent;
    }
  }

  /* Additions on top of the forked original: header/footer zone colors
     (scoped to classes unique to this file, so they can never affect the
     default drawer's own .theme-drawer__header/.cart-drawer__summary
     styling) and spacing for the milestone bar. */
  .custom-cart-drawer-zones__header-zone {
    background-color: var(--custom-drawer-header-bg);
    color: var(--custom-drawer-header-text);
  }

  /* .theme-drawer__header, .theme-drawer__badge, and .theme-drawer__close-button
     all set their own explicit `color` in theme-drawer-styles.liquid, which breaks
     plain `color: inherit` (it would inherit from the nearest explicit ancestor,
     not from the header zone two levels up) - set the custom color directly on
     each instead of relying on inheritance. */
  .custom-cart-drawer-zones__header-zone .theme-drawer__header,
  .custom-cart-drawer-zones__header-zone .theme-drawer__title,
  .custom-cart-drawer-zones__header-zone .theme-drawer__badge,
  .custom-cart-drawer-zones__header-zone .theme-drawer__close-button {
    color: var(--custom-drawer-header-text);
  }

  .cart-drawer__summary.custom-cart-drawer-zones__footer-zone {
    background-color: var(--custom-drawer-footer-bg);
    color: var(--custom-drawer-footer-text);
    /* Remove the scroll-fade mask the original drawer uses above its sticky
       summary - it read as an unwanted gradient once the footer has its own
       background color. */
    mask-image: none;
  }

  /* Same explicit-color-breaks-inheritance issue as the header: force every
     text-bearing descendant except form controls, pills/badges with their own
     background, and the checkout button (which uses the theme's own button
     color scheme) to the custom footer text color. */
  .cart-drawer__summary.custom-cart-drawer-zones__footer-zone
    :not(input, textarea, .button, .button *, .cart-discount__pill, .cart-discount__pill *, .custom-cart-drawer-zones__savings-badge, .additional-checkout-buttons, .additional-checkout-buttons *) {
    color: var(--custom-drawer-footer-text);
  }

  /* Compact, uniform line items condensed to the height of the product image
     (one uniform block per row), with a merchant-controlled thumbnail size
     and a smaller pill-style quantity selector/remove button. Scoped to
     .cart-drawer__items so it only affects rows rendered inside this drawer -
     cart-products.liquid itself is untouched. */
  .cart-drawer__items .cart-items__table-row {
    grid-template-columns: var(--custom-drawer-thumbnail-size, 96px) minmax(0, 1fr) minmax(3.5rem, auto);
    grid-auto-rows: min-content;
    align-items: stretch;
    column-gap: var(--gap-md);
    min-height: var(--custom-drawer-thumbnail-size, 96px);
  }

  .cart-drawer__items .cart-items__media {
    height: var(--custom-drawer-thumbnail-size, 96px);
  }

  .cart-drawer__items .cart-items__media-container {
    width: var(--custom-drawer-thumbnail-size, 96px);
    height: var(--custom-drawer-thumbnail-size, 96px);
    border-radius: var(--custom-drawer-radius-md, 10px);
    overflow: hidden;
  }

  .cart-drawer__items .cart-items__details,
  .cart-drawer__items .cart-items__quantity {
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-height: var(--custom-drawer-thumbnail-size, 96px);
    overflow: hidden;
  }

  .cart-drawer__items .cart-items__title {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cart-drawer__items .cart-items__product-info,
  .cart-drawer__items .cart-items__variants-wrapper,
  .cart-drawer__items .cart-items__unit-price-wrapper {
    font-size: var(--font-size--xs);
  }

  .cart-drawer__items .cart-items__quantity-controls {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
  }

  .cart-drawer__items .quantity-selector {
    /* Redefining --minimum-touch-target here (rather than sizing the
       .quantity-minus/.quantity-plus buttons directly) keeps it in sync with
       quantity-selector-styles.liquid's own input max-width formula
       (quantity-selector-width - minimum-touch-target * 2) - hardcoding the
       button size without this caused that formula to go negative and hide
       the number entirely on narrow (mobile) widths. */
    --quantity-selector-width: 100px;
    --minimum-touch-target: 30px;

    border-radius: var(--custom-drawer-radius-pill, 999px);
  }

  .cart-drawer__items .quantity-selector .quantity-minus,
  .cart-drawer__items .quantity-selector .quantity-plus {
    border-radius: var(--custom-drawer-radius-pill, 999px);
  }

  .cart-drawer__items .cart-items__remove {
    width: 30px;
    height: 30px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--custom-drawer-radius-pill, 999px);
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  .cart-drawer__items .cart-items__remove svg {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }
{% endstylesheet %}
