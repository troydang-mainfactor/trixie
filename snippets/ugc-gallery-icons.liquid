{%- comment -%}
  ------------------------------------------------------------------------------
  UGC Gallery — SVG icon library
  ------------------------------------------------------------------------------
  Renders a single inline SVG icon. All icons are 24x24, stroke/fill via
  currentColor so they inherit the surrounding text color.

  Usage:
    {% render 'ugc-gallery-icons', icon: 'tiktok' %}
    {% render 'ugc-gallery-icons', icon: 'play', size: 32 %}

  Accepts:
    - icon {String}  one of: tiktok, instagram, youtube, link, play, heart,
                     verified, chevron-left, chevron-right, close,
                     volume-on, volume-off, bag
    - size {Number}  optional, rendered px size (default 20)
  ------------------------------------------------------------------------------
{%- endcomment -%}

{%- liquid
  assign s = size | default: 20
-%}

{%- case icon -%}

{%- when 'tiktok' -%}
<svg class="ugcg-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M16.6 1.5h-3.3v13.9a2.9 2.9 0 1 1-2.9-2.9c.3 0 .6 0 .9.1V9.2a6.3 6.3 0 0 0-.9-.07 6.27 6.27 0 1 0 6.27 6.27V8.56a8.1 8.1 0 0 0 4.73 1.5V6.8a4.8 4.8 0 0 1-3.3-1.34 4.85 4.85 0 0 1-1.5-3.96Z"/></svg>

{%- when 'instagram' -%}
<svg class="ugcg-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="0.9" fill="currentColor" stroke="none"/></svg>

{%- when 'youtube' -%}
<svg class="ugcg-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M23 12s0-3.26-.42-4.82a3.02 3.02 0 0 0-2.12-2.14C18.9 4.62 12 4.62 12 4.62s-6.9 0-8.46.42A3.02 3.02 0 0 0 1.42 7.18C1 8.74 1 12 1 12s0 3.26.42 4.82a3.02 3.02 0 0 0 2.12 2.14c1.56.42 8.46.42 8.46.42s6.9 0 8.46-.42a3.02 3.02 0 0 0 2.12-2.14C23 15.26 23 12 23 12ZM9.8 15.6V8.4L15.8 12l-6 3.6Z"/></svg>

{%- when 'link' -%}
<svg class="ugcg-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>

{%- when 'play' -%}
<svg class="ugcg-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8 5.14v13.72c0 .89.98 1.43 1.73.95l10.28-6.86a1.13 1.13 0 0 0 0-1.9L9.73 4.19A1.13 1.13 0 0 0 8 5.14Z"/></svg>

{%- when 'play-outline' -%}
<svg class="ugcg-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 5.14v13.72c0 .89.98 1.43 1.73.95l10.28-6.86a1.13 1.13 0 0 0 0-1.9L9.73 4.19A1.13 1.13 0 0 0 8 5.14Z"/></svg>

{%- when 'heart' -%}
<svg class="ugcg-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 21s-7.5-4.7-10-9.2C.3 8.6 2.2 4.9 5.7 4.3c2-.34 3.9.5 5.1 2.1a5.5 5.5 0 0 1 5.1-2.1c3.5.6 5.4 4.3 3.7 7.5C19.5 16.3 12 21 12 21Z"/></svg>

{%- when 'verified' -%}
<svg class="ugcg-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 1.5 14.7 3.6l3.4-.3 1 3.2 3 1.7-1.2 3.2 1.2 3.2-3 1.7-1 3.2-3.4-.3L12 22.5 9.3 20.4l-3.4.3-1-3.2-3-1.7 1.2-3.2L1.9 9.4l3-1.7 1-3.2 3.4.3L12 1.5Z"/><path d="m8.4 12.2 2.4 2.4 4.8-4.9" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>

{%- when 'chevron-left' -%}
<svg class="ugcg-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m15 5-7 7 7 7"/></svg>

{%- when 'chevron-right' -%}
<svg class="ugcg-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7"/></svg>

{%- when 'close' -%}
<svg class="ugcg-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18"/></svg>

{%- when 'volume-on' -%}
<svg class="ugcg-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 5 6 9H2v6h4l5 4V5Z" fill="currentColor"/><path d="M15.5 8.5a5 5 0 0 1 0 7M18.4 5.6a9 9 0 0 1 0 12.8"/></svg>

{%- when 'volume-off' -%}
<svg class="ugcg-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 5 6 9H2v6h4l5 4V5Z" fill="currentColor"/><path d="m22 9-6 6M16 9l6 6"/></svg>

{%- when 'bag' -%}
<svg class="ugcg-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 7h12l1 14H5L6 7Z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/></svg>

{%- endcase -%}
