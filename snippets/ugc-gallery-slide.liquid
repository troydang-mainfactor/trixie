{%- comment -%}
  ------------------------------------------------------------------------------
  UGC Gallery — fullscreen modal slide
  ------------------------------------------------------------------------------
  One vertical slide inside the fullscreen modal (TikTok-style feed).
  Rendered once per block, in the same "featured first" order as the cards,
  so data-index values match between card triggers and slides.

  Video loading strategy:
    <source> elements carry data-src instead of src. ugc-gallery.js attaches
    the real src only when the slide becomes active (or is the immediate
    next/previous neighbour), so opening the modal never downloads the whole
    feed. Videos autoplay muted (required by mobile browsers); a mute toggle
    lets shoppers enable sound.

  Accepts:
    - block    {Block}   the section block
    - index    {Number}  display index
    - sset     {Object}  section.settings
  ------------------------------------------------------------------------------
{%- endcomment -%}

{%- liquid
  assign bs = block.settings
  assign has_video = false
  if bs.video != blank
    assign has_video = true
  endif

  assign poster = blank
  if has_video
    assign poster = bs.video.preview_image
  elsif bs.image != blank
    assign poster = bs.image
  endif

  comment
    Products: the block's product list (up to 10 tagged products).
    CTA fallback: custom URL when no products are tagged.
    CTA label: block override, else section default.
  endcomment
  assign plist = bs.products
  assign cta_url = blank
  if plist.count == 0 and bs.custom_url != blank
    assign cta_url = bs.custom_url
  endif
  assign cta_label = bs.cta_label | default: sset.cta_label
-%}

<div class="ugcg-slide" data-slide-index="{{ index }}" role="group" aria-roledescription="slide" aria-label="{{ index | plus: 1 }}">
  <div class="ugcg-slide__stage">
    {%- if has_video -%}
      <video
        class="ugcg-slide__video"
        playsinline
        loop
        muted
        preload="none"
        {% if poster != blank %}poster="{{ poster | image_url: width: 900 }}"{% endif %}
      >
        {%- for source in bs.video.sources -%}
          {%- if source.format == 'mp4' -%}
            <source data-src="{{ source.url }}" type="{{ source.mime_type }}">
          {%- endif -%}
        {%- endfor -%}
      </video>
      <button type="button" class="ugcg-slide__playpause" data-ugcg-playpause aria-label="Pause video">
        {% render 'ugc-gallery-icons', icon: 'play', size: 30 %}
      </button>
    {%- elsif poster != blank -%}
      <img
        class="ugcg-slide__image"
        src="{{ poster | image_url: width: 1080 }}"
        srcset="{{ poster | image_url: width: 720 }} 720w, {{ poster | image_url: width: 1080 }} 1080w"
        sizes="100vw"
        width="{{ poster.width }}"
        height="{{ poster.height }}"
        loading="lazy"
        alt="{{ bs.caption | default: bs.username | escape }}"
      >
    {%- endif -%}

    <div class="ugcg-slide__overlay">
      <div class="ugcg-slide__body">
        <div class="ugcg-slide__info">
          {%- if bs.username != blank -%}
          <div class="ugcg-slide__creator">
            {%- if bs.avatar != blank -%}
              <img
                class="ugcg-avatar ugcg-avatar--lg"
                src="{{ bs.avatar | image_url: width: 96 }}"
                width="96"
                height="96"
                loading="lazy"
                alt=""
              >
            {%- endif -%}
            <span class="ugcg-slide__handle">{{ bs.username | escape }}</span>
            {%- if bs.verified -%}
              <span class="ugcg-verified">{% render 'ugc-gallery-icons', icon: 'verified', size: 15 %}</span>
            {%- endif -%}
            {%- if sset.show_platform -%}
              <span class="ugcg-slide__platform">
                {%- case bs.platform -%}
                  {%- when 'tiktok' -%}{% render 'ugc-gallery-icons', icon: 'tiktok', size: 15 %}
                  {%- when 'instagram' -%}{% render 'ugc-gallery-icons', icon: 'instagram', size: 15 %}
                  {%- when 'youtube' -%}{% render 'ugc-gallery-icons', icon: 'youtube', size: 15 %}
                  {%- else -%}{% render 'ugc-gallery-icons', icon: 'link', size: 15 %}
                {%- endcase -%}
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}

          {%- if bs.caption != blank -%}
            <p class="ugcg-slide__caption">{{ bs.caption | escape }}</p>
          {%- endif -%}
        </div>

        <div class="ugcg-slide__rail">
          {%- if bs.likes != blank -%}
            <span class="ugcg-slide__likes">
              {% render 'ugc-gallery-icons', icon: 'heart', size: 24 %}
              <span>{{ bs.likes | escape }}</span>
            </span>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%}
          Product pill carousel (LyveCom-style). One pill per view; arrows +
          horizontal scroll-snap swipe move between tagged products.
        {%- endcomment -%}
        {%- if sset.show_product_card and plist.count > 0 -%}
          <div class="ugcg-pcarousel" data-ugcg-pcarousel>
            {%- if plist.count > 1 -%}
              <button type="button" class="ugcg-pcarousel__nav" data-ugcg-pnav="prev" aria-label="Previous product">
                {% render 'ugc-gallery-icons', icon: 'chevron-left', size: 14 %}
              </button>
            {%- endif -%}
            <div class="ugcg-pcarousel__track" data-ugcg-ptrack>
              {%- for p in plist -%}
                <a class="ugcg-product" href="{{ p.url }}">
                  {%- if p.featured_image != blank -%}
                    <img
                      class="ugcg-product__img"
                      src="{{ p.featured_image | image_url: width: 128 }}"
                      width="128"
                      height="128"
                      loading="lazy"
                      alt="{{ p.featured_image.alt | default: p.title | escape }}"
                    >
                  {%- endif -%}
                  <span class="ugcg-product__text">
                    <span class="ugcg-product__title">{{ p.title | escape }}</span>
                    <span class="ugcg-product__price">
                      {{ p.price | money }}
                      {%- if p.compare_at_price > p.price -%}
                        <s class="ugcg-product__compare">{{ p.compare_at_price | money }}</s>
                      {%- endif -%}
                    </span>
                  </span>
                  <span class="ugcg-product__divider" aria-hidden="true"></span>
                  <span class="ugcg-product__cta">{{ cta_label | escape }}</span>
                </a>
              {%- endfor -%}
            </div>
            {%- if plist.count > 1 -%}
              <button type="button" class="ugcg-pcarousel__nav" data-ugcg-pnav="next" aria-label="Next product">
                {% render 'ugc-gallery-icons', icon: 'chevron-right', size: 14 %}
              </button>
            {%- endif -%}
          </div>
        {%- elsif cta_url != blank -%}
          <a class="ugcg-slide__cta" href="{{ cta_url }}">{{ cta_label | escape }}</a>
        {%- endif -%}
    </div>
  </div>
</div>
