{%- doc -%}
  Free shipping progress bar for the custom cart drawer's header zone.

  Single bar, driven by real cart.total_price against one merchant-set
  threshold (settings.free_shipping_threshold). Renders nothing if the
  threshold is blank/zero, or once the cart has reached/passed it (shows
  a "reached" message instead of a full bar with nothing left to fill).

  Both messages are merchant-editable text settings (not translation keys)
  so they can be customized per-store; settings.free_shipping_remaining_text
  uses the literal placeholder "[amount]" for where the remaining total
  should be substituted in.
{%- enddoc -%}

{% liquid
  assign threshold = settings.free_shipping_threshold | default: 0
  # settings.free_shipping_threshold is a plain number the merchant enters in
  # whole currency units (e.g. 50 for $50.00), but cart.total_price is always
  # in the smallest currency unit (cents) - convert before comparing, or a
  # $12.00 (1200-cent) cart would look bigger than a "50" threshold and the
  # bar would always read as reached regardless of the actual cart total.
  assign threshold_cents = threshold | times: 100
%}

{% if threshold > 0 %}
  {% liquid
    assign remaining = threshold_cents | minus: cart.total_price
    assign reached = false
    if remaining <= 0
      assign reached = true
      assign fill_percent = 100
    else
      assign fill_percent = cart.total_price | times: 100.0 | divided_by: threshold_cents
      assign fill_percent = fill_percent | at_most: 100
    endif

    assign remaining_money = remaining | money
    assign remaining_text_template = settings.free_shipping_remaining_text | default: 'Spend [amount] more for free shipping'
    assign remaining_text = remaining_text_template | replace: '[amount]', remaining_money
    assign reached_text = settings.free_shipping_reached_text | default: "You've unlocked free shipping!"
  %}

  <div
    class="custom-cart-drawer__free-shipping"
    style="
      --milestone-track-color: {{ settings.free_shipping_track_color }};
      --milestone-fill-color: {{ settings.free_shipping_fill_color }};
      --milestone-bar-height: {{ settings.free_shipping_bar_height | default: 8 }}px;
    "
  >
    <p class="custom-cart-drawer__free-shipping-message">
      {% if reached %}
        {{ reached_text }}
      {% else %}
        {{ remaining_text }}
      {% endif %}
    </p>
    <div class="custom-cart-drawer__milestone-track">
      <div
        class="custom-cart-drawer__milestone-fill"
        style="width: {{ fill_percent }}%;"
      ></div>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .custom-cart-drawer__free-shipping {
    padding-inline: var(--padding-lg);
    padding-block-end: var(--padding-lg);
    text-align: center;
  }

  .custom-cart-drawer__free-shipping-message {
    margin: 0 0 var(--margin-2xs);
    font-size: var(--font-size--sm);
  }

  .custom-cart-drawer__milestone-track {
    position: relative;
    height: var(--milestone-bar-height);
    border-radius: calc(var(--milestone-bar-height) / 2);
    background: var(--milestone-track-color);
    overflow: hidden;
  }

  .custom-cart-drawer__milestone-fill {
    height: 100%;
    border-radius: inherit;
    background: var(--milestone-fill-color);
    transition: width var(--animation-speed) var(--animation-easing);
  }
{% endstylesheet %}
