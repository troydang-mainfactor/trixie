{%- doc -%}
  Milestone progress bar for the custom cart drawer's header zone.

  Reads from global theme settings (four fixed milestone slots -
  milestone_1_* through milestone_4_*) rather than section blocks, since
  sections/cart-drawer-section.liquid has no editor-reachable settings
  surface of its own (see cart-drawer-custom.liquid's doc comment). A slot
  is skipped entirely when its threshold is blank/zero, so merchants who
  only want 1-2 milestones simply leave the rest empty.

  PHASE 2: renders real tiers (threshold/label/icon) from theme settings -
  the fill percentage is a placeholder until phase 3 wires this to
  cart.total_price.
{%- enddoc -%}

{% liquid
  assign m1 = settings.milestone_1_threshold | default: 0
  assign m2 = settings.milestone_2_threshold | default: 0
  assign m3 = settings.milestone_3_threshold | default: 0
  assign m4 = settings.milestone_4_threshold | default: 0

  assign max_threshold = 0
  if m1 > max_threshold
    assign max_threshold = m1
  endif
  if m2 > max_threshold
    assign max_threshold = m2
  endif
  if m3 > max_threshold
    assign max_threshold = m3
  endif
  if m4 > max_threshold
    assign max_threshold = m4
  endif

  # PHASE 2 PLACEHOLDER - replaced with a real cart.total_price-based value in phase 3.
  assign placeholder_fill_percent = 45
%}

{% if max_threshold > 0 %}
  <div
    class="custom-cart-drawer__milestones"
    style="
      --milestone-track-color: {{ settings.milestone_track_color }};
      --milestone-fill-color: {{ settings.milestone_fill_color }};
      --milestone-bar-height: {{ settings.milestone_bar_height | default: 8 }}px;
    "
  >
    <div class="custom-cart-drawer__milestone-track">
      <div
        class="custom-cart-drawer__milestone-fill"
        style="width: {{ placeholder_fill_percent }}%;"
      ></div>
      {% if m1 > 0 %}
        {% render 'cart-drawer-custom-milestone-badge',
          threshold: m1,
          label: settings.milestone_1_label,
          icon: settings.milestone_1_icon,
          custom_icon: settings.milestone_1_custom_icon,
          max_threshold: max_threshold,
          fill_percent: placeholder_fill_percent
        %}
      {% endif %}
      {% if m2 > 0 %}
        {% render 'cart-drawer-custom-milestone-badge',
          threshold: m2,
          label: settings.milestone_2_label,
          icon: settings.milestone_2_icon,
          custom_icon: settings.milestone_2_custom_icon,
          max_threshold: max_threshold,
          fill_percent: placeholder_fill_percent
        %}
      {% endif %}
      {% if m3 > 0 %}
        {% render 'cart-drawer-custom-milestone-badge',
          threshold: m3,
          label: settings.milestone_3_label,
          icon: settings.milestone_3_icon,
          custom_icon: settings.milestone_3_custom_icon,
          max_threshold: max_threshold,
          fill_percent: placeholder_fill_percent
        %}
      {% endif %}
      {% if m4 > 0 %}
        {% render 'cart-drawer-custom-milestone-badge',
          threshold: m4,
          label: settings.milestone_4_label,
          icon: settings.milestone_4_icon,
          custom_icon: settings.milestone_4_custom_icon,
          max_threshold: max_threshold,
          fill_percent: placeholder_fill_percent
        %}
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .custom-cart-drawer__milestones {
    padding-inline: var(--padding-lg);
    padding-block-end: var(--padding-lg);
  }

  .custom-cart-drawer__milestone-track {
    position: relative;
    height: var(--milestone-bar-height);
    border-radius: calc(var(--milestone-bar-height) / 2);
    background: var(--milestone-track-color);
    margin-block-start: var(--padding-xl);
  }

  .custom-cart-drawer__milestone-fill {
    height: 100%;
    border-radius: inherit;
    background: var(--milestone-fill-color);
    transition: width var(--animation-speed) var(--animation-easing);
  }

  .custom-cart-drawer__milestone-badge {
    position: absolute;
    top: 50%;
    translate: -50% -50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-3xs);
  }

  .custom-cart-drawer__milestone-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(var(--milestone-bar-height) + 12px);
    height: calc(var(--milestone-bar-height) + 12px);
    border-radius: 50%;
    background: var(--milestone-track-color);
    color: var(--milestone-fill-color);
    opacity: 0.6;
  }

  .custom-cart-drawer__milestone-badge--reached .custom-cart-drawer__milestone-icon {
    background: var(--milestone-fill-color);
    color: var(--custom-cart-drawer-header-bg);
    opacity: 1;
  }

  .custom-cart-drawer__milestone-label {
    position: absolute;
    top: 100%;
    margin-block-start: var(--gap-3xs);
    font-size: var(--font-size--xs);
    white-space: nowrap;
  }
{% endstylesheet %}
