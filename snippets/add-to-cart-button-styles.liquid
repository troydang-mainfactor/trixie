{%- doc -%}
  Shared add-to-cart button styles used by product forms, quick add,
  and sticky add-to-cart.

  @example
  {% render 'add-to-cart-button-styles' %}
{%- enddoc -%}

{% stylesheet %}
  /* Add to cart button */
  .button[id^='BuyButtons-ProductSubmitButton-'] {
    position: relative;
    overflow: hidden;
  }

  .add-to-cart-button {
    --text-speed: 0.26;

    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap-2xs);
    user-select: none;
    transition-property: color, box-shadow, background-color, scale, translate;
    transition-duration: var(--animation-speed);
    transition-timing-function: var(--ease-out-cubic);

    &:active {
      scale: 0.99;
      translate: 0 1px;
    }
  }

  .add-to-cart-text {
    --atc-opacity: 0;
    --atc-destination: -1em;

    display: flex;
    gap: var(--gap-2xs);
    align-items: center;
    justify-content: center;
    animation-duration: var(--animation-speed);
    animation-timing-function: var(--animation-easing);
    animation-fill-mode: forwards;
    transition: width var(--animation-speed) var(--animation-easing),
      opacity var(--animation-speed) var(--animation-easing);
  }

  .add-to-cart__added {
    --atc-opacity: 1;
    --atc-destination: 0px;

    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
  }

  .add-to-cart__loader {
    --add-to-cart-dot-size: 0.35em;
    --add-to-cart-dot-gap: 0.47em;
    --add-to-cart-dot-dim: color-mix(in srgb, currentcolor 20%, transparent);

    width: var(--add-to-cart-dot-size);
    aspect-ratio: 1;
    border-radius: 50%;
    opacity: 0;
  }

  [data-added='true'] .add-to-cart-text,
  [data-added='true'] .add-to-cart__added {
    animation-name: atc-slide;
  }

  .add-to-cart-button[data-added='true'] {
    color: transparent;

    .add-to-cart__added {
      color: var(--button-color);
    }

    .add-to-cart-button__price {
      opacity: 0;
    }

    .add-to-cart__loader {
      opacity: 1;
      background: currentcolor;
      box-shadow: var(--add-to-cart-dot-gap) 0 currentcolor, calc(var(--add-to-cart-dot-gap) * -1) 0 currentcolor;
    }

    .add-to-cart-text {
      /* stylelint-disable-next-line plugin/no-unsupported-browser-features */
      clip-path: circle(0% at 50% 50%);
      filter: blur(2px);
      opacity: 0;
      translate: 0 4px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .add-to-cart-button[data-added='true'] .add-to-cart__loader {
      animation: add-to-cart-dot-pulse 0.55s ease-in-out 3 alternate;
      animation-fill-mode: forwards;
    }

    .add-to-cart-text {
      transition-property: clip-path, opacity, filter, translate;
      transition-duration: calc((var(--text-speed) * 0.6s)), calc((var(--text-speed) * 1s));
      transition-timing-function: ease-out;
    }
  }

  @keyframes add-to-cart-dot-pulse {
    0% {
      background: currentcolor;
      box-shadow: var(--add-to-cart-dot-gap) 0 currentcolor, calc(var(--add-to-cart-dot-gap) * -1) 0 var(--add-to-cart-dot-dim);
    }

    33% {
      background: var(--add-to-cart-dot-dim);
      box-shadow: var(--add-to-cart-dot-gap) 0 currentcolor, calc(var(--add-to-cart-dot-gap) * -1) 0 var(--add-to-cart-dot-dim);
    }

    66% {
      background: var(--add-to-cart-dot-dim);
      box-shadow: var(--add-to-cart-dot-gap) 0 var(--add-to-cart-dot-dim), calc(var(--add-to-cart-dot-gap) * -1) 0 currentcolor;
    }

    100% {
      background: currentcolor;
      box-shadow: var(--add-to-cart-dot-gap) 0 var(--add-to-cart-dot-dim), calc(var(--add-to-cart-dot-gap) * -1) 0 currentcolor;
    }
  }

  .add-to-cart-text {
    /* stylelint-disable-next-line plugin/no-unsupported-browser-features */
    clip-path: circle(100% at 50% 50%);
  }

  @keyframes atc-slide {
    to {
      opacity: var(--atc-opacity, 1);
      translate: 0px var(--atc-destination, 0px);
    }
  }

  .add-to-cart-button__price {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2xs);
  }

  .add-to-cart-button__price-divider {
    opacity: 0.5;
  }

  /* Overrides base.css's .compare-at-price, which colors it off
     --color-foreground-rgb - fine on a plain-text price, but on a solid-color
     button (a custom background/text pair, or the theme's primary button
     color) that read as low-contrast or mismatched, because it ignored
     whatever color the button's own label was using. currentcolor ties it to
     the button's actual text color instead, so it stays legible on any
     button color and is themeable the same way the button label already is
     (Theme settings > Buttons, or this block's own Custom text color). */
  .add-to-cart-button__price .compare-at-price {
    color: currentcolor;
    text-decoration-color: currentcolor;
    opacity: var(--opacity-subdued-text);
  }

  /* Keep the button label on one line on product cards - narrow mobile columns otherwise
     wrap "Add to bag" (plus the price, when shown) onto a second line. text-overflow doesn't
     apply on a flex container, so the fix is to make the content fit (smaller font/price,
     tighter gap) rather than truncate it; overflow:hidden is just a safety net. */
  :is(.product-grid__item, .resource-list__item) .add-to-cart-button {
    overflow: hidden;
    white-space: nowrap;
  }

  :is(.product-grid__item, .resource-list__item) .add-to-cart-button__price {
    font-size: 0.85em;
  }

  @media screen and (max-width: 749px) {
    :is(.product-grid__item, .resource-list__item)
      .product-form-buttons
      > *:not(.quantity-selector-wrapper, .quantity-rules, .quantity-label, .volume-pricing, .product-form-text__error) {
      min-width: 0;
    }

    :is(.product-grid__item, .resource-list__item) .add-to-cart-button {
      gap: var(--gap-3xs);
      font-size: 0.8125rem;
    }
  }
{% endstylesheet %}
