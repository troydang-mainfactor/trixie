{%- comment -%}
  Resolves a `tab-item` block's configured content source to its rendered HTML/text output.
  Pure logic - no visibility checks here (see product-info-check-visibility.liquid) so either
  concern can be extended independently (e.g. a new content source never touches visibility).

  `render` gives the rendered snippet its own variable scope (unlike the legacy `include` tag),
  so a variable assigned in here can't leak back into the caller - this snippet instead echoes
  its result as output, and the caller captures it: e.g.
    {% capture resolved_content %}{% render 'product-info-resolve-content', block: block, product: product %}{% endcapture %}
    {% assign resolved_content_stripped = resolved_content | strip_html | strip_newlines | strip %}

  @param {object} block - The `tab-item` block (reads `block.settings`).
  @param {object} product - The contextual product.
{%- endcomment -%}

{%- liquid
  assign resolved_content = ''

  case block.settings.content_source
    when 'rich_text'
      assign resolved_content = block.settings.rich_text_content

    when 'product_description'
      assign resolved_content = product.description

    when 'page'
      assign resolved_content = block.settings.page_reference.content

    when 'metafield'
      assign metafield_path = block.settings.metafield_reference | strip | split: '.'
      if metafield_path.size == 2
        assign resolved_content = product.metafields[metafield_path[0]][metafield_path[1]].value
      endif

    when 'metaobject'
      # Generic best-effort field lookup: this iteration's schema has no per-store field-key
      # config (see brief non-goals), so check common field-naming conventions in priority
      # order instead of assuming a specific store's metaobject definition. First non-blank wins.
      assign metaobject_reference = block.settings.metaobject_reference
      assign resolved_content = metaobject_reference.content.value | default: metaobject_reference.body.value | default: metaobject_reference.text.value | default: metaobject_reference.description.value

    when 'dynamic_source'
      # Free-text drop-path shorthand rather than a fixed dropdown of pre-written fields, so any
      # product attribute or "namespace.key" metafield can be targeted without a schema change.
      assign dynamic_source_path = block.settings.dynamic_source_reference | strip
      case dynamic_source_path
        when 'product.description'
          assign resolved_content = product.description
        when 'product.title'
          assign resolved_content = product.title
        when 'product.vendor'
          assign resolved_content = product.vendor
        when 'product.type'
          assign resolved_content = product.type
        else
          assign dynamic_source_parts = dynamic_source_path | split: '.'
          if dynamic_source_parts.size == 2
            assign resolved_content = product.metafields[dynamic_source_parts[0]][dynamic_source_parts[1]].value
          endif
      endcase

    when 'custom_liquid'
      # The `liquid` schema setting type is parsed/executed by Shopify at render time, so simply
      # outputting the setting value is enough - no manual template evaluation needed here.
      assign resolved_content = block.settings.custom_liquid_content
  endcase
-%}
{{- resolved_content -}}
