{%- doc -%}
  Evaluates a `tab-item` block's visibility rules against a product. Pure predicate — no content
  resolution here (see product-info-resolve-content.liquid) so either concern can be extended
  independently.

  Liquid snippets can't return values directly, so this establishes a capture + boolean-string
  convention: it outputs the literal string `true` or `false`, and callers capture that output.

  Rule slots are fixed at 3 in the schema (Liquid schema can't do dynamic repeating groups), but
  this loop reads however many `rule_N_type`/`rule_N_value` settings exist via computed keys, so
  raising `rule_count` below to support a `rule_4` later is a schema-only change, not a rewrite.

  @param {object} block - The `tab-item` block (reads `block.settings`).
  @param {object} product - The product being evaluated against.

  @example
  {% capture is_visible %}{% render 'product-info-check-visibility', block: block, product: product %}{% endcapture %}
  {% if is_visible == 'true' %} ... {% endif %}
{%- enddoc -%}

{%- liquid
  assign rule_count = 3
  assign matched_count = 0
  assign checked_count = 0

  for i in (1..rule_count)
    assign rule_type_key = 'rule_' | append: i | append: '_type'
    assign rule_value_key = 'rule_' | append: i | append: '_value'
    assign rule_type = block.settings[rule_type_key]
    assign rule_value = block.settings[rule_value_key]

    if rule_type == blank or rule_type == 'none'
      continue
    endif

    assign checked_count = checked_count | plus: 1
    assign rule_matched = false

    case rule_type
      when 'product_type'
        if product.type == rule_value
          assign rule_matched = true
        endif

      when 'product_vendor'
        if product.vendor == rule_value
          assign rule_matched = true
        endif

      when 'product_template'
        if product.template_suffix == rule_value
          assign rule_matched = true
        endif

      when 'product_tag'
        if product.tags contains rule_value
          assign rule_matched = true
        endif

      when 'collection'
        assign target_collection = collections[rule_value]
        if target_collection != blank and product.collections contains target_collection
          assign rule_matched = true
        endif

      when 'availability'
        if rule_value == 'available' and product.available
          assign rule_matched = true
        elsif rule_value == 'sold_out' and product.available == false
          assign rule_matched = true
        endif

      when 'metafield_value'
        # rule_value format: "namespace.key=expected value"
        assign metafield_rule_parts = rule_value | split: '='
        if metafield_rule_parts.size == 2
          assign metafield_path = metafield_rule_parts[0] | strip | split: '.'
          assign metafield_expected_value = metafield_rule_parts[1] | strip
          if metafield_path.size == 2
            assign metafield_rule_result = product.metafields[metafield_path[0]][metafield_path[1]].value
            if metafield_rule_result == metafield_expected_value
              assign rule_matched = true
            endif
          endif
        endif

      when 'customer_logged_in'
        if customer != blank
          assign rule_matched = true
        endif
    endcase

    if rule_matched
      assign matched_count = matched_count | plus: 1
    endif
  endfor

  assign visibility_result = false

  if checked_count == 0
    # No rules configured (or all set to "Always show") — visible unconditionally.
    assign visibility_result = true
  elsif block.settings.visibility_match == 'any'
    if matched_count > 0
      assign visibility_result = true
    endif
  elsif matched_count == checked_count
    assign visibility_result = true
  endif
-%}
{{- visibility_result -}}
