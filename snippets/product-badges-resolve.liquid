{%- doc -%}
  Resolves which badges (up to 2) should show for a product, in display order. Pure logic, no
  markup - outputs a comma-separated list of badge keys via echo, since a render can't leak
  assigned variables back to its caller. Keys are one of: `sold_out`, `sale`, or `tag:{block.id}`.

  Precedence (this is the single source of truth other callers should never re-derive):
  1. Sold out - always shows first when applicable.
  2. Sale - shows next when applicable and not sold out.
  3. The single highest-priority matching tag rule (first match in merchant-defined rule order),
     shown only if there's still room under the 2-badge cap.

  Tag rules are read from sections['product_badge_rules'].blocks - see
  sections/product-badge-rules.liquid for why that's where they live. Tag matching is exact and
  case-insensitive (Shopify tags aren't case-normalized, so "New Arrival" and "new arrival" must
  both match a rule configured as either).

  @param {object} product - The product to resolve badges for.

  @example
  {% capture badge_keys %}{% render 'product-badges-resolve', product: product %}{% endcapture %}
  {% assign badge_keys = badge_keys | strip | split: ',' %}
{%- enddoc -%}

{%- liquid
  # Sold out and sale are independent, additive conditions (a product can be both at once) -
  # only the lower-priority tag rule ever gets dropped by the 2-badge cap below.
  assign badge_keys = ''
  assign badge_count = 0

  if product.available == false
    assign badge_keys = badge_keys | append: 'sold_out,'
    assign badge_count = badge_count | plus: 1
  endif

  if product.compare_at_price > product.price
    assign badge_keys = badge_keys | append: 'sale,'
    assign badge_count = badge_count | plus: 1
  endif

  if badge_count < 2
    assign product_tags_downcased = product.tags | map: 'downcase'
    assign matched_rule_id = ''

    # theme-check-disable UndefinedObject
    # `sections` is a real global (https://shopify.dev/docs/api/liquid/objects/sections) exposing
    # every section rendered on the current page by ID - theme-check just doesn't model it.
    for block in sections['product_badge_rules'].blocks
      # theme-check-enable UndefinedObject
      if matched_rule_id != ''
        break
      endif
      if block.type != 'badge-rule' or block.settings.tag == blank or block.settings.label == blank
        continue
      endif

      assign rule_tag_downcased = block.settings.tag | strip | downcase
      if product_tags_downcased contains rule_tag_downcased
        assign matched_rule_id = block.id
      endif
    endfor

    if matched_rule_id != ''
      assign badge_keys = badge_keys | append: 'tag:' | append: matched_rule_id | append: ','
    endif
  endif
-%}
{{- badge_keys -}}
